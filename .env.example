# microCMS の設定（https://microcms.io の管理画面から取得）
# サービスドメイン: https://<これ>.microcms.io
MICROCMS_SERVICE_DOMAIN=your-service-domain
# 読み取り専用 API キー（ビルド時のコンテンツ取得に使用）
MICROCMS_API_KEY=your-read-api-key
# 記事本文の iframe 埋め込み許可ホスト（任意、カンマ区切り）
# 例: PUBLIC_MICROCMS_ALLOWED_IFRAME_HOSTNAMES=example.com,player.example.com
PUBLIC_MICROCMS_ALLOWED_IFRAME_HOSTNAMES=

# 既存記事のマイグレーション時のみ使用する書き込み用 API キー
# （scripts/migrate-to-microcms.ts 実行時。通常のビルドには不要）
MICROCMS_WRITE_API_KEY=your-write-api-key
