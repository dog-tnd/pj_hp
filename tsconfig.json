{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": ["@types/react", "@types/react-dom"], // 型定義を追加
    "skipLibCheck": true
  },
  "include": [".astro/types.d.ts", "src", "**/*.astro"],
  // archive/ は退避したファイル置き場。"**/*.astro" が src の外にも効くため除外する（dist は継承元の既定値）
  "exclude": ["dist", "archive"]
}
