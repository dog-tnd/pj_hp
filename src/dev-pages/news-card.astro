---
import Layout from "../layouts/Layout.astro";
import NewsCard from "../components/NewsCard";
import { externalAriaLabel, toPostCardItems } from "../utils/post-card";
import type { ExternalPost } from "../lib/microcms";
import { formatDotDate } from "../utils/date";

// microCMS を呼ばずにカードのレイアウトを確認するためのサンプル。
// タイトル・説明の長さを変えて、行数が増えたときに崩れないかを見る。
const samples = [
  {
    label: "短いタイトル / 短い説明",
    title: "新歓ガイダンス",
    description: "新入生向けのガイダンスを行いました。",
  },
  {
    label: "2行になるタイトル / 2行の説明",
    title: "TND✖︎WILL 合同ハッカソンを開催しました",
    description:
      "他大学のサークルと合同でハッカソンを開催しました。当日の様子と、チーム開発で得られた学びを紹介します。",
  },
  {
    label: "極端に長いタイトル / 極端に長い説明",
    title:
      "東京理科大学プログラミングサークルTNDが主催する新入生向けTeX入門講座を開きました！という長いタイトル",
    description:
      "本文の説明がとても長い場合の表示確認です。カードの高さは固定なので、指定した行数を超えた分は省略されて表示されるはずです。ここで下の著者情報や日付が押し出されていないかを確認します。",
  },
];

const common = {
  image: "/thumbnail_sample.jpg",
  author: "N.T",
  role: "Webチームリーダー",
  authorImage: "/icon_sample.jpg",
  date: "2025.09.19",
  url: "#",
};

// 外部サイトの記事のサンプル（spec 008）。toPostCardItems に通すので、
// 表示できない記事（下の「表示されない」もの）は出ず、dev サーバーのログに理由が出る
const LIGHT = "/thumbnail_sample.jpg";
const DARK = "/blog/2025-10-04/engineer.jpg";
const base = {
  createdAt: "2026-01-01T00:00:00.000Z",
  updatedAt: "2026-01-01T00:00:00.000Z",
  revisedAt: "2026-01-01T00:00:00.000Z",
};
const external = (
  id: string,
  site: string[],
  url: string,
  title: string,
  image: string,
): ExternalPost => ({
  ...base,
  id,
  publishedAt: "2026-10-20T03:00:00.000Z",
  url,
  site,
  title,
  description:
    "外部サイトに書いた記事の説明文。押すと新しいタブで外部サイトの記事が開く。",
  author: "Ryoma",
  role: "メンバー",
  image: { url: image },
  tags: [],
});
const externalItems = toPostCardItems(
  [],
  [
    external(
      "zenn-dark",
      ["Zenn"],
      "https://zenn.dev/tnd/articles/sample",
      "Zenn の記事（暗い画像）",
      DARK,
    ),
    external(
      "qiita-light",
      ["Qiita"],
      "https://qiita.com/tnd/items/sample",
      "Qiita の記事（明るい画像）",
      LIGHT,
    ),
    external(
      "other-dark",
      ["その他"],
      "https://note.com/tnd/n/sample",
      "その他のサイトの記事（暗い画像）",
      DARK,
    ),
    // ここから下は表示されない（ログに理由が出る）
    external(
      "invalid-http",
      ["その他"],
      "http://example.com/",
      "【表示されないはず】https でない",
      LIGHT,
    ),
    external(
      "invalid-host",
      ["Zenn"],
      "https://qiita.com/tnd/items/sample",
      "【表示されないはず】Zenn なのに qiita.com",
      LIGHT,
    ),
    external(
      "invalid-userinfo",
      ["Zenn"],
      "https://zenn.dev@example.com/",
      "【表示されないはず】zenn.dev@example.com",
      LIGHT,
    ),
    external(
      "invalid-site",
      [],
      "https://zenn.dev/tnd/articles/sample",
      "【表示されないはず】種類が空",
      LIGHT,
    ),
  ],
);
---

<Layout title="NewsCard 表示サンプル（dev限定）" noindex={true}>
  <main class="mx-auto max-w-7xl px-4 py-12">
    <div class="mb-8 rounded-sm border border-yellow-300 bg-yellow-100 px-4 py-2 text-sm text-yellow-800">
      開発時のみ表示される確認用ページです（本番ビルドには含まれません）
    </div>

    <h1 class="mb-6 text-2xl font-bold text-gray-900">NewsCard 表示サンプル</h1>
    <p class="mb-8 text-sm text-gray-600">
      本番（トップページ・ブログ一覧）と同じグリッド設定で並べています。
      文字数が増えても著者情報・日付が押し出されないかを確認します。
    </p>

    <!-- 本番と同じグリッド設定 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 custom-md:grid-cols-3 gap-6 w-full">
      {samples.map((sample) => (
        <div>
          <p class="mb-2 text-xs text-gray-500">{sample.label}</p>
          <NewsCard
            image={common.image}
            title={sample.title}
            description={sample.description}
            author={common.author}
            role={common.role}
            authorImage={common.authorImage}
            date={common.date}
            url={common.url}
            client:load
          />
        </div>
      ))}
    </div>

    <h2 class="mb-4 mt-12 text-xl font-bold text-gray-900">
      外部サイトの記事（spec 008）
    </h2>
    <p class="mb-8 text-sm text-gray-600">
      画像の左上にサイトの名前、右上に外部リンクのアイコン。新しいタブで開く。
      不正な URL の記事は表示されず、dev サーバーのログに理由が出る。
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 custom-md:grid-cols-3 gap-6 w-full">
      {externalItems.map((item) => (
        <NewsCard
          image={item.image}
          title={item.title}
          description={item.description}
          author={item.author}
          role={item.role}
          authorImage={item.authorImage}
          date={formatDotDate(item.publishedAt)}
          url={item.url}
          external={item.external ? { label: item.external.label } : undefined}
          ariaLabel={externalAriaLabel(item)}
          client:load
        />
      ))}
    </div>
  </main>
</Layout>
