---
import Layout from '../layouts/Layout.astro';
import { sanitizeBlogHtml } from '../utils/sanitize';
import { convertInlineCode } from '../utils/inline-code';
import { highlightCodeBlocks } from '../utils/highlight';

// microCMS を呼ばずに本文の描画パイプラインだけを確認するためのサンプル。
// 固定HTMLなので .env は不要。astro.config.mjs により dev でのみルートが注入される。
const sampleBody = [
  '<h2>インラインコード</h2>',
  '<p>リッチエディタのインラインコード <code>useState</code> と、' +
    'バッククォート記法の `const x = 1` が同じ見た目になり、' +
    'バッククォート自体が表示されないことを確認する。</p>',
  '<h2>コードブロック（言語指定あり）</h2>',
  '<pre><code class="language-typescript">type Post = { id: string };\n\nexport function toUrl(post: Post): string {\n  return "/blog/" + post.id;\n}</code></pre>',
  '<pre><code class="language-python">def greet(name: str) -&gt; str:\n    return f"hello {name}"</code></pre>',
  '<pre><code class="language-bash">pnpm install\npnpm dev</code></pre>',
  '<h2>コードブロック（フォールバック）</h2>',
  '<pre><code class="language-unknownlang">未対応の言語はハイライト無しで表示される</code></pre>',
  '<pre><code>言語指定なしのコードブロック</code></pre>',
  '<h2>その他の要素</h2>',
  '<ul><li>リスト項目</li><li>もう一つの項目</li></ul>',
  '<blockquote><p>引用ブロックの表示確認</p></blockquote>',
].join('\n');

// 本番の記事本文とまったく同じ整形パイプラインを通す
const bodyHtml = await highlightCodeBlocks(
  convertInlineCode(sanitizeBlogHtml(sampleBody))
);
---

<Layout title="コード表示サンプル（dev限定）" noindex={true}>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <div
      class="mb-8 rounded border border-yellow-300 bg-yellow-100 px-4 py-2 text-sm text-yellow-800"
    >
      開発時のみ表示される確認用ページです（本番ビルドには含まれません）
    </div>

    <!-- 記事本文と同じラッパー class を使い、本番と同じ見た目で確認する -->
    <div class="prose prose-lg max-w-none" set:html={bodyHtml}></div>
  </main>
</Layout>
