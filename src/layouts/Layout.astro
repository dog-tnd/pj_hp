---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  keywords?: string[];
  author?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title,
  description = "「TND」は東京理科大学野田キャンパスで活動するプログラミングサークルです。Web開発やデータサイエンスに挑戦し、メンバーと共に成長を目指しています。",
  image = "/mainCharm.svg",
  canonicalURL = Astro.url.href,
  keywords = ["東京理科大学", "プログラミングサークル", "TND", "Web開発", "データサイエンス", "野田キャンパス"],
  author = "TND",
  type = "website",
  noindex = false
} = Astro.props;

const siteURL = "https://tus-tnd.com";
const fullImageURL = image.startsWith('http') ? image : `${siteURL}${image}`;

// サイト全体の構造化データ。Google や AI による概要に「TND とは何か」を伝える。
// 説明文にはサイト内のどこかに表示されている事実だけを書く（spec 003）。
// TND は大学の非公認サークルのため、memberOf / parentOrganization は付けない。
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteURL}/#organization`,
      name: "TND",
      alternateName: [
        "東京理科大学プログラミングサークルTND",
        "TND 東京理科大学プログラミングサークル",
      ],
      description:
        "東京理科大学の学生によるプログラミングサークル。野田キャンパスを拠点に2024年に設立し、約40名が所属。Web開発・デザイン・データサイエンスの3チームに分かれ、週1回の勉強会やハッカソンで実践的に学んでいる。メンバーの9割は大学からプログラミングを始めた。",
      url: `${siteURL}/`,
      logo: {
        "@type": "ImageObject",
        url: `${siteURL}/logo.png`,
        width: 192,
        height: 192,
      },
      foundingDate: "2024",
      location: {
        "@type": "Place",
        name: "東京理科大学 野田キャンパス",
        address: {
          "@type": "PostalAddress",
          addressRegion: "千葉県",
          addressLocality: "野田市",
          addressCountry: "JP",
        },
      },
      knowsAbout: [
        "プログラミング",
        "Web開発",
        "フロントエンド",
        "バックエンド",
        "UI/UXデザイン",
        "データサイエンス",
        "機械学習",
        "ハッカソン",
      ],
      sameAs: ["https://x.com/TokyorikaND", "https://github.com/dog-tnd"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteURL}/#website`,
      name: "TND",
      alternateName: "東京理科大学プログラミングサークルTND",
      url: `${siteURL}/`,
      inLanguage: "ja",
      publisher: { "@id": `${siteURL}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="author" content={author} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:site_name" content="TND - 東京理科大学プログラミングサークル" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageURL} />
    <meta property="twitter:site" content="@TokyorikaND" />

    <!-- JSON-LD structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />

    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Rubik+Doodle+Shadow&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Abel&display=swap" rel="stylesheet">

    <!-- 各ページ固有の head 要素（記事ページの構造化データなど）を受け取る -->
    <slot name="head" />
  </head>
  <body class="bg-gray-50">
    <div class="relative min-h-screen overflow-hidden">
      <!-- Gradient shape -->
      <div class="absolute right-0 top-0 -z-10">
        <div class="h-[600px] w-[600px] rotate-12 transform rounded-[40%] bg-gradient-to-br from-blue-400 to-teal-300 opacity-20 blur-3xl"></div>
      </div>
      <main>
        <slot />
      </main>
    </div>
    <style is:global>
      body {
        font-family: 'Noto Sans JP', sans-serif;
      }

      .vertical {
        writing-mode: vertical-rl;
    }
    </style>
  </body>
