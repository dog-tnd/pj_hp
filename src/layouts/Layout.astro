---
import "../styles/tailwind.css";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  keywords?: string[];
  author?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title,
  description = "「TND」は東京理科大学野田キャンパスで活動するプログラミングサークルです。Web開発やデータサイエンスに挑戦し、メンバーと共に成長を目指しています。",
  image = "/mainCharm.svg",
  canonicalURL = Astro.url.href,
  keywords = [
    "東京理科大学",
    "プログラミングサークル",
    "TND",
    "Web開発",
    "データサイエンス",
    "野田キャンパス",
  ],
  author = "TND",
  type = "website",
  noindex = false,
} = Astro.props;

const siteURL = "https://tus-tnd.com";
const fullImageURL = image.startsWith("http") ? image : `${siteURL}${image}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="author" content={author} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    <meta
      property="og:site_name"
      content="TND - 東京理科大学プログラミングサークル"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageURL} />
    <meta property="twitter:site" content="@TokyorikaND" />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "TND",
        "description": "東京理科大学野田キャンパスで活動するプログラミングサークル",
        "url": "https://tus-tnd.com",
        "logo": "https://tus-tnd.com/logo.png",
        "sameAs": [
          "https://x.com/TokyorikaND",
          "https://discord.gg/k3qMBEn3CC"
        ],
        "foundingDate": "2024",
        "memberOf": {
          "@type": "Organization",
          "name": "東京理科大学"
        }
      }
    </script>
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik+Doodle+Shadow&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Abel&display=swap"
      rel="stylesheet"
    />

    <!-- 各ページ固有の head 要素（記事ページの構造化データなど）を受け取る -->
    <slot name="head" />
  </head>
  <body class="bg-gray-50">
    <SiteHeader />
    <!-- overflow-hidden だと中の position: sticky（記事の目次）が効かないため、
         スクロールコンテナを作らない overflow-clip で切る。clip を解釈しない古いブラウザでは
         overflow-hidden が残り、見た目は今までどおりになる（Tailwind の出力順で clip が後に来る） -->
    <div class="relative min-h-screen overflow-hidden overflow-clip">
      <!-- 背景のぼかし。左右交互に置き、ページの高さより下のものは overflow-clip で切れる。
           lg 未満は小さめの3個、lg 以上は4個（spec 004） -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10"
      >
        <div class="absolute -right-[140px] -top-10 h-[340px] w-[340px] rotate-12 rounded-[40%] bg-gradient-to-br from-blue-400 to-teal-300 opacity-[0.22] blur-[48px] lg:-right-[120px] lg:-top-20 lg:h-[600px] lg:w-[600px] lg:blur-3xl"></div>
        <div class="absolute -left-[160px] top-[900px] h-[320px] w-[320px] -rotate-12 rounded-[40%] bg-gradient-to-br from-tnd-blue to-tnd-violet opacity-[0.16] blur-[48px] lg:-left-[220px] lg:top-[640px] lg:h-[540px] lg:w-[540px] lg:blur-3xl"></div>
        <div class="absolute -right-[150px] top-[1800px] h-[330px] w-[330px] rotate-12 rounded-[40%] bg-gradient-to-br from-tnd-teal to-tnd-mint opacity-[0.16] blur-[48px] lg:-right-[200px] lg:top-[1260px] lg:h-[560px] lg:w-[560px] lg:blur-3xl"></div>
        <div class="absolute -left-[160px] top-[1880px] hidden h-[500px] w-[500px] -rotate-12 rounded-[40%] bg-gradient-to-br from-blue-400 to-teal-300 opacity-[0.16] blur-3xl lg:block"></div>
      </div>
      <main class="pb-24 lg:pb-0">
        <slot />
      </main>
    </div>
    <style is:global>
      body {
        font-family: "Noto Sans JP", sans-serif;
      }

      .vertical {
        writing-mode: vertical-rl;
      }
    </style>
  </body>
</html>
