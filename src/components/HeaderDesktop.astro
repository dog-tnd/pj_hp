---
const pathname = Astro.url.pathname;

const links = [
  { href: "/about", label: "私たちについて" },
  { href: "/blog", label: "テックブログ" },
  { href: "/faq", label: "よくある質問" },
  { href: "/contact", label: "お問い合わせ" },
];

const isCurrent = (href: string) =>
  href === "/blog"
    ? pathname.startsWith("/blog")
    : pathname === href || pathname === `${href}/`;
---

<!-- ヘッダーは画面に固定し、元の場所には高さ 80px の空きを置く。
     ページの流れの中（sticky）で 80px → 64px に縮めると、その分ページ全体が上に詰まり、スクロール中にかくっと跳ねるため -->
<div class="header-spacer" aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="header-bg" aria-hidden="true"></div>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="TND ホーム">
      <img src="/logo.png" alt="" width="40" height="40" />
      <span>TND</span>
    </a>

    <nav aria-label="メインナビゲーション">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["nav-link", { current: isCurrent(link.href) }]}
          aria-current={isCurrent(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <span class="divider" aria-hidden="true"></span>
    <button class="join-button" type="button" data-open-join>
      入会申し込み
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const updateHeader = () => {
    header?.classList.toggle("scrolled", window.scrollY > 26);
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
</script>

<style>
  .header-spacer {
    height: 80px;
  }

  /* スクロールで 80px → 64px に縮める。高さ（height）を動かすと1コマごとに配置の計算と背景のぼかしの描き直しが起き、
     実機でコマ落ちして背景とボタンがずれて見えるため、箱の高さは 80px のまま、見た目だけを transform で動かす。
     背景は上を基準に 0.8 倍（64px）に縮め、中身は 8px 上げて 64px の中央にそろえる。どちらも同じ時間・緩急で動かす */
  .site-header {
    position: fixed;
    top: 0;
    /* モーダルでスクロールバーが消えたときは、その幅を右に空けて位置を保つ（scroll-lock.ts） */
    right: var(--scrollbar-width, 0px);
    left: 0;
    z-index: 50;
    display: block;
    height: 80px;
    /* 縮んだ後の下 16px は透明な箱が残るので、押せるのはリンクとボタンだけにする（下の追従する部品を押せるように） */
    pointer-events: none;
  }

  .header-bg {
    position: absolute;
    inset: 0;
    transform-origin: top;
    background-color: rgba(249, 250, 251, 0);
    box-shadow: 0 1px 0 rgba(17, 24, 39, 0);
    -webkit-backdrop-filter: blur(0);
    backdrop-filter: blur(0);
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease,
      -webkit-backdrop-filter 180ms ease,
      backdrop-filter 180ms ease;
  }

  .site-header.scrolled .header-bg {
    transform: scaleY(0.8);
    background-color: rgba(249, 250, 251, 0.97);
    box-shadow: 0 1px 0 rgba(17, 24, 39, 0.08);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    position: relative;
    width: min(100%, 1440px);
    height: 100%;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    transition: transform 180ms ease;
  }

  .site-header.scrolled .header-inner {
    transform: translateY(-8px);
  }

  .header-inner a,
  .header-inner button {
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-bg,
    .header-inner {
      transition: none;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: #111827;
    text-decoration: none;
  }

  .brand img {
    width: 40px;
    height: 40px;
  }

  .brand span {
    font-family: "Rubik Doodle Shadow", system-ui;
    font-size: 32px;
    line-height: 1;
  }

  nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    position: relative;
    padding: 8px 0;
    color: #4b5563;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 2px;
    background: #bfdbfe;
    opacity: 0;
    transform: scaleX(0.5);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  .nav-link:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-link.current::after {
    opacity: 1;
    transform: scaleX(1);
    background: #3b82f6;
  }

  .nav-link.current {
    font-weight: 700;
    color: #111827;
  }

  .nav-link:focus-visible,
  .join-button:focus-visible {
    outline: 2px solid white;
    outline-offset: 4px;
    box-shadow: 0 0 0 4px #3b82f6;
    border-radius: 8px;
  }

  .divider {
    width: 1px;
    height: 20px;
    margin: 0 28px;
    background: #d1d5db;
  }

  .join-button {
    height: 44px;
    padding: 0 24px;
    border: 0;
    border-radius: 10px;
    background: #f5bf48;
    box-shadow:
      0 1px 2px rgba(17, 24, 39, 0.1),
      0 6px 16px rgba(245, 191, 72, 0.28);
    color: white;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition:
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .join-button:hover {
    background: linear-gradient(94deg, #f5bf48 0%, #f7bc5b 42%, #efa169 100%);
    box-shadow: 0 10px 20px rgba(239, 161, 105, 0.28);
    transform: translateY(-1px);
  }
</style>
