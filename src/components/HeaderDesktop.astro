---
const pathname = Astro.url.pathname;

const links = [
  { href: "/about", label: "私たちについて" },
  { href: "/blog", label: "テックブログ" },
  { href: "/faq", label: "よくある質問" },
  { href: "/contact", label: "お問い合わせ" },
];

const isCurrent = (href: string) =>
  href === "/blog"
    ? pathname.startsWith("/blog")
    : pathname === href || pathname === `${href}/`;
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="TND ホーム">
      <img src="/logo.png" alt="" width="40" height="40" />
      <span>TND</span>
    </a>

    <nav aria-label="メインナビゲーション">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["nav-link", { current: isCurrent(link.href) }]}
          aria-current={isCurrent(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <span class="divider" aria-hidden="true"></span>
    <button class="join-button" type="button" data-open-join>
      入会申し込み
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const updateHeader = () => {
    header?.classList.toggle("scrolled", window.scrollY > 26);
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: block;
    width: 100%;
    height: 80px;
    background: transparent;
    transition:
      height 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .site-header.scrolled {
    height: 64px;
    background: rgba(249, 250, 251, 0.97);
    box-shadow: 0 1px 0 rgba(17, 24, 39, 0.08);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    width: min(100%, 1440px);
    height: 100%;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: #111827;
    text-decoration: none;
  }

  .brand img {
    width: 40px;
    height: 40px;
  }

  .brand span {
    font-family: "Rubik Doodle Shadow", system-ui;
    font-size: 32px;
    line-height: 1;
  }

  nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    position: relative;
    padding: 8px 0;
    color: #4b5563;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 2px;
    background: #bfdbfe;
    opacity: 0;
    transform: scaleX(0.5);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  .nav-link:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-link.current::after {
    opacity: 1;
    transform: scaleX(1);
    background: #3b82f6;
  }

  .nav-link.current {
    font-weight: 700;
    color: #111827;
  }

  .nav-link:focus-visible,
  .join-button:focus-visible {
    outline: 2px solid white;
    outline-offset: 4px;
    box-shadow: 0 0 0 4px #3b82f6;
    border-radius: 8px;
  }

  .divider {
    width: 1px;
    height: 20px;
    margin: 0 28px;
    background: #d1d5db;
  }

  .join-button {
    height: 44px;
    padding: 0 24px;
    border: 0;
    border-radius: 10px;
    background: #f5bf48;
    box-shadow:
      0 1px 2px rgba(17, 24, 39, 0.1),
      0 6px 16px rgba(245, 191, 72, 0.28);
    color: white;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition:
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .join-button:hover {
    background: linear-gradient(94deg, #f5bf48 0%, #f7bc5b 42%, #efa169 100%);
    box-shadow: 0 10px 20px rgba(239, 161, 105, 0.28);
    transform: translateY(-1px);
  }
</style>
