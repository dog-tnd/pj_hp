---
// 記事のシェアボタン4つ（X・Facebook・LinkedIn・リンクをコピー）。
// variant="icon" は右の列用（すべてアイコンだけ）、"labeled" は本文の後用（X とコピーだけラベル付き）。
// コピーの結果を読み上げる領域（data-copy-status）は BlogArticleView に1つだけ置く。
interface Props {
  url: string;
  title: string;
  variant: "icon" | "labeled";
}

const { url, title, variant } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodedUrl}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;

const labeled = variant === "labeled";

const focusRing =
  "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600";
const iconButton = `inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-900 transition-colors hover:bg-gray-100 ${focusRing}`;
const pillButton = `inline-flex h-11 items-center justify-center gap-2 rounded-full px-[18px] text-sm font-medium transition-colors ${focusRing}`;
---

<div class="flex flex-wrap items-center gap-2">
  <a
    href={xUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={
      labeled
        ? `${pillButton} bg-gray-900 text-white hover:bg-gray-700`
        : iconButton
    }
    aria-label={labeled ? "Xでポスト" : "Xでシェア"}
  >
    <svg
      class="h-4 w-4"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
    </svg>
    {labeled && <span>ポスト</span>}
  </a>

  <a
    href={facebookUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={iconButton}
    aria-label="Facebookでシェア"
  >
    <svg
      class="h-[18px] w-[18px]"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
        clip-rule="evenodd"
      ></path>
    </svg>
  </a>

  <a
    href={linkedInUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={iconButton}
    aria-label="LinkedInでシェア"
  >
    <svg
      class="h-4 w-4"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
    </svg>
  </a>

  <!-- data-copied の間だけ、チェックのアイコン（とラベル）に切り替える -->
  <button
    type="button"
    data-copy-link
    data-url={url}
    class:list={[
      "group",
      labeled
        ? `${pillButton} border border-gray-300 bg-white text-gray-900 hover:bg-gray-100`
        : iconButton,
    ]}
    aria-label={labeled ? undefined : "リンクをコピー"}
  >
    <svg
      class="h-4 w-4 group-data-[copied]:hidden"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"></path>
      <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"></path>
    </svg>
    <svg
      class="hidden h-4 w-4 text-blue-600 group-data-[copied]:block"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M5 13l4 4L19 7"></path>
    </svg>
    {labeled && (
      <>
        <span class="group-data-[copied]:hidden">リンクをコピー</span>
        <span class="hidden group-data-[copied]:inline">コピーしました</span>
      </>
    )}
  </button>
</div>

<script>
  import "../../scripts/copy-link";
</script>
