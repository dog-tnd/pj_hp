---
// モバイル/タブレット用ヘッダー。どの画面幅で表示するかは SiteHeader.astro が決める。
// 全画面メニューは <dialog> + showModal() で実装し、
// フォーカストラップ・Escapeキー・背景の inert 化はブラウザの既定動作に任せる。
interface Link {
  href: string;
  label: string;
}

const links: Link[] = [
  { href: "/about", label: "私たちについて" },
  { href: "/blog", label: "テックブログ" },
  { href: "/faq", label: "よくある質問" },
  { href: "/contact", label: "お問い合わせ" },
];

// 現在地判定：/blog のみ前方一致、それ以外は完全一致＋末尾スラッシュ許容
const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/blog"
    ? pathname.startsWith("/blog")
    : pathname === href || pathname === `${href}/`;
---

<header class="sticky top-0 z-50 h-14 bg-gray-50/85 backdrop-blur-md">
  <div class="flex h-full items-center justify-between pl-4 pr-3 md:pl-8 md:pr-6">
    <a href="/" aria-label="TND ホーム" class="flex items-center gap-2">
      <img src="/logo.png" alt="" class="w-7 h-7 rounded-full" />
      <span
        class="text-2xl leading-none text-[#111827]"
        style="font-family: 'Rubik Doodle Shadow', system-ui"
      >
        TND
      </span>
    </a>
    <button
      type="button"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-open-menu
      class="w-11 h-11 rounded-[10px] flex flex-col items-center justify-center gap-1.5"
    >
      <span class="h-0.5 w-[22px] bg-gray-900 rounded-sm"></span>
      <span class="h-0.5 w-[22px] bg-gray-900 rounded-sm"></span>
      <span class="h-0.5 w-[14px] bg-gray-900 rounded-sm"></span>
    </button>
  </div>
</header>

<dialog
  id="mobile-menu"
  data-menu
  data-scroll-lock
  class="w-screen h-dvh max-w-none max-h-none m-0 p-0 border-0 bg-[#111827] text-white"
>
  <div class="flex h-14 items-center justify-between pl-4 pr-[calc(0.75rem_+_var(--scrollbar-width,0px))] md:pl-8 md:pr-[calc(1.5rem_+_var(--scrollbar-width,0px))]">
    <a href="/" aria-label="TND ホーム" class="flex items-center gap-2">
      <img src="/logo.png" alt="" class="w-7 h-7 rounded-full" />
      <span
        class="text-2xl leading-none text-white"
        style="font-family: 'Rubik Doodle Shadow', system-ui"
      >
        TND
      </span>
    </a>
    <button
      type="button"
      aria-label="メニューを閉じる"
      autofocus
      data-close-menu
      class="w-11 h-11 flex items-center justify-center text-white text-2xl"
    >
      ×
    </button>
  </div>

  <nav aria-label="メインナビゲーション" class="px-6 md:px-8 pt-[76px]">
    <ul class="md:max-w-[520px] md:mx-auto">
      {links.map((link, index) => {
        const current = isCurrent(link.href);
        return (
          <li>
            <a
              href={link.href}
              aria-current={current ? "page" : undefined}
              class="flex h-[72px] items-center gap-4 border-b border-white/10"
            >
              <span
                class="w-6 font-mono text-xs"
                style={{ color: current ? "#93C5FD" : "#9CA3AF" }}
              >
                {String(index + 1).padStart(2, "0")}
              </span>
              <span
                class={`text-[28px] leading-tight ${
                  current ? "font-bold text-white" : "font-medium text-gray-100"
                }`}
              >
                {link.label}
              </span>
              {current && (
                <span class="ml-auto w-2 h-2 rounded-full bg-[#93C5FD]"></span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div data-menu-cta class="absolute inset-x-6 bottom-9 md:max-w-[520px] md:mx-auto md:inset-x-0">
    <button
      type="button"
      data-open-join
      class="h-[60px] w-full rounded-[14px] bg-[#F5BF48] text-white text-lg font-bold"
    >
      入会申し込み
    </button>
  </div>
</dialog>

<button
  type="button"
  data-open-join
  class="fixed right-[calc(1rem_+_var(--scrollbar-width,0px))] bottom-7 z-40 h-[52px] px-[22px] rounded-full bg-[#F5BF48] text-white text-[15px] font-bold shadow-[0_4px_8px_rgba(17,24,39,.12),0_12px_28px_rgba(245,191,72,.34)]"
>
  入会申し込み
</button>


<style>
  /* メニュー展開時、背景の暗転をふわっと見せる。Tailwind に keyframes が無いためここだけ CSS */
  @media (prefers-reduced-motion: no-preference) {
    #mobile-menu[open] {
      animation: menu-fade 280ms ease-out;
    }
    #mobile-menu[open] nav,
    #mobile-menu[open] [data-menu-cta] {
      animation: menu-rise 280ms ease-out;
    }

    /* 閉じるときは逆再生でふわっと戻す。forwards で終了状態を保ち、close() までのちらつきを防ぐ */
    #mobile-menu[open][data-closing] {
      animation: menu-fade-out 280ms ease-in forwards;
    }
    #mobile-menu[open][data-closing] nav,
    #mobile-menu[open][data-closing] [data-menu-cta] {
      animation: menu-sink 280ms ease-in forwards;
    }
  }

  @keyframes menu-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes menu-rise {
    from { transform: translateY(8px); }
    to { transform: translateY(0); }
  }

  @keyframes menu-fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes menu-sink {
    from { transform: translateY(0); }
    to { transform: translateY(8px); }
  }
</style>

<script>
  import { syncScrollLock } from "../scripts/scroll-lock";

  // メニューの開閉制御（入会モーダルは JoinDialog.astro が担当）
  const menu = document.getElementById("mobile-menu") as HTMLDialogElement;
  const openMenuButton = document.querySelector("[data-open-menu]") as HTMLButtonElement;
  const closeMenuButton = document.querySelector("[data-close-menu]") as HTMLButtonElement;
  const menuJoinButton = menu.querySelector("[data-open-join]") as HTMLButtonElement;

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // メニューはフェードアウトを再生してから閉じる。視差効果を減らす設定ならすぐ閉じる
  let finishClosing: ((e: AnimationEvent) => void) | null = null;
  const closeMenu = () => {
    if (!menu.open || finishClosing) return;
    if (reduceMotion.matches) {
      menu.close();
      return;
    }
    // 子要素のアニメーション終了もバブリングしてくるので、dialog 自身のものだけ拾う
    finishClosing = (e) => {
      if (e.target === menu) menu.close();
    };
    menu.addEventListener("animationend", finishClosing);
    menu.setAttribute("data-closing", "");
  };

  openMenuButton.addEventListener("click", () => {
    menu.showModal();
    openMenuButton.setAttribute("aria-expanded", "true");
    syncScrollLock();
  });

  closeMenuButton.addEventListener("click", closeMenu);

  // Escape でもフェードアウトさせる（既定の即時クローズを止める）
  menu.addEventListener("cancel", (e) => {
    e.preventDefault();
    closeMenu();
  });

  // メニュー内の「入会申し込み」。モーダルは JoinDialog が開くので、ここではメニューを即時に閉じるだけ。
  // フェードさせないのは、モーダルへのフォーカス移動と重なって不具合が出やすいため
  menuJoinButton.addEventListener("click", () => {
    if (menu.open) menu.close();
  });

  // Escapeキーで閉じた場合も close イベントで拾えるので、ここで状態を戻す
  menu.addEventListener("close", () => {
    // フェードアウト途中に入会ボタンなど別経路で閉じられても、次に開いたとき即閉じないよう必ず初期化する
    if (finishClosing) menu.removeEventListener("animationend", finishClosing);
    finishClosing = null;
    menu.removeAttribute("data-closing");
    openMenuButton.setAttribute("aria-expanded", "false");
    syncScrollLock();
  });

  // 余白（dialog 自身）のクリックで閉じる
  menu.addEventListener("click", (e) => {
    if (e.target === menu) closeMenu();
  });
</script>
