---
// 404 ページのターミナル（spec 007）。1024px 以上だけに出す（D3）。
// 動きは scripts/not-found-terminal.ts。JavaScript が無いときは最初の出力の2行だけを出す
import { HINTS, INTRO_LINES } from "../../utils/not-found-commands";

const staticLines = INTRO_LINES.slice(0, 2);
const toneClass = {
  out: "text-gray-200",
  dim: "text-gray-400",
  err: "text-orange-300",
  go: "text-teal-300",
} as const;
const chips = ["help", "tree", "whoami", "sl"];
const hintButtonClass =
  "inline-flex size-11 shrink-0 items-center justify-center rounded-[10px] text-gray-600 hover:bg-gray-100 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 focus-visible:outline-solid";
---

<section
  class="hidden lg:block"
  aria-label="ターミナル（コマンドでページを探せます）"
  data-terminal
>
  <div class="overflow-hidden rounded-[14px] bg-gray-900 shadow-[0_1px_2px_rgba(17,24,39,.08),0_24px_48px_-12px_rgba(17,24,39,.35)]">
    <div
      class="flex h-11 items-center gap-2 border-b border-gray-800 px-4"
      aria-hidden="true"
    >
      <span class="size-3 rounded-full bg-gray-700"></span>
      <span class="size-3 rounded-full bg-gray-700"></span>
      <span class="size-3 rounded-full bg-gray-700"></span>
      <span class="mr-[52px] flex-1 text-center font-mono text-xs text-gray-400">
        guest@tnd — zsh
      </span>
    </div>

    <div class="relative">
      <div
        class="h-[420px] overflow-y-auto overscroll-contain px-5 pt-3.5 pb-[22px] font-mono text-sm leading-[1.75] text-gray-200"
        data-terminal-body
      >
        <!-- 最初の出力が終わるまでは読み上げない（スクリプトが出し直すため。二重に読ませない） -->
        <div role="log" aria-live="off" data-terminal-log>
          {staticLines.map((line) => (
            <div
              class:list={[
                "min-h-[1.75em] wrap-break-word",
                toneClass[line.tone],
              ]}
            >
              {line.text}
            </div>
          ))}
        </div>

        <!-- プロンプト（Starship 風。D2）。スクリプトが出す -->
        <div class="mt-3" data-terminal-prompt hidden>
          <div
            class="mb-1 flex flex-wrap items-center gap-y-1"
            aria-hidden="true"
          >
            <span class="segment rounded-l-[5px] bg-tnd-blue pr-4 pl-2.5 text-white">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="8" r="4"></circle>
                <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
              </svg>
              guest
            </span>
            <span class="segment segment-next -ml-[7px] max-w-full min-w-0 bg-tnd-violet pr-4 pl-[18px] text-gray-900">
              <svg
                class="shrink-0"
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path>
              </svg>
              <span class="truncate" data-terminal-dir>
                ~
              </span>
            </span>
            <span class="segment segment-next -ml-[7px] bg-tnd-teal pr-4 pl-[18px] text-gray-900">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="6" cy="5" r="2"></circle>
                <circle cx="6" cy="19" r="2"></circle>
                <circle cx="18" cy="7" r="2"></circle>
                <path d="M6 7v10M18 9c0 4.5-4 5.5-10.5 8.5"></path>
              </svg>
              main
            </span>
            <span class="segment segment-next -ml-[7px] bg-tnd-mint pr-4 pl-[18px] text-gray-900">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 2"></path>
              </svg>
              404ms
            </span>
          </div>

          <!-- 自動入力の間だけ出す。タグの間の空白が表示に出ないよう flex で並べる -->
          <div
            class="flex items-center"
            aria-hidden="true"
            data-terminal-typing
            hidden
          >
            <span class="mr-[1ch] shrink-0 font-semibold text-green-400">
              ❯
            </span>
            <span
              class="min-w-0 wrap-break-word whitespace-pre-wrap"
              data-terminal-typed
            ></span>
            <span class="caret ml-px h-[1.15em] w-[.6em] shrink-0 bg-teal-300"></span>
          </div>

          <form
            class="flex items-center rounded-sm has-[input:focus-visible]:outline-2 has-[input:focus-visible]:outline-offset-4 has-[input:focus-visible]:outline-blue-300 has-[input:focus-visible]:outline-solid"
            data-terminal-form
            hidden
          >
            <label for="not-found-cmd" class="sr-only">
              コマンドを入力
            </label>
            <span
              class="mr-[1ch] shrink-0 font-semibold text-red-400"
              aria-hidden="true"
              data-terminal-chevron
            >
              ❯
            </span>
            <input
              id="not-found-cmd"
              type="text"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="go"
              placeholder="help"
              class="h-[1.75em] min-w-0 flex-1 bg-transparent p-0 [font:inherit] text-gray-50 caret-teal-300 outline-hidden placeholder:text-gray-400"
            />
          </form>
        </div>
      </div>

      <!-- sl の汽車。位置はスクリプトが style.transform で動かす -->
      <pre
        class="pointer-events-none absolute top-1/2 left-0 m-0 bg-gray-900 font-mono text-[13px] leading-tight text-gray-50"
        aria-hidden="true"
        data-terminal-train
        hidden
      ></pre>
    </div>
  </div>

  <div
    class="mt-3.5 flex flex-wrap items-center gap-2"
    data-terminal-chips
    hidden
  >
    <span class="mr-1 text-[13px] text-gray-500">試してみる</span>
    {chips.map((command) => (
      <button
        type="button"
        data-terminal-run={command}
        class="inline-flex min-h-11 items-center rounded-full border border-gray-200 bg-white px-4 font-mono text-[13px] text-gray-700 hover:border-blue-500 hover:bg-blue-50 hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 focus-visible:outline-solid"
      >
        {command}
      </button>
    ))}
  </div>

  <!-- ヒント（D6）。切り替えはスクリプト。文字はスクリプトと同じ形で最初の1つを出しておく -->
  <div
    class="mt-3 flex items-center gap-1 rounded-xl border border-gray-200 bg-white py-1 pr-1 pl-4"
    data-terminal-hints
    hidden
  >
    <span
      class="shrink-0 font-['Inter'] text-[11px] font-semibold tracking-[0.16em] text-gray-500"
      aria-hidden="true"
      data-terminal-hint-number
    >
      HINT 1/{HINTS.length}
    </span>
    <p
      class="ml-2.5 min-w-0 flex-1 text-sm leading-[1.7] text-gray-600"
      aria-live="polite"
      data-terminal-hint-text
    >
      {HINTS[0].map((part) =>
        part.code ? (
          <code class="rounded-[5px] bg-gray-100 px-1.5 font-mono text-[.9em] text-gray-900">
            {part.text}
          </code>
        ) : (
          part.text
        ),
      )}
    </p>
    <button
      type="button"
      class={hintButtonClass}
      aria-label="前のヒント"
      data-terminal-hint-step="-1"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 6l-6 6 6 6"></path>
      </svg>
    </button>
    <button
      type="button"
      class={hintButtonClass}
      aria-label="次のヒント"
      data-terminal-hint-step="1"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 6l6 6-6 6"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  import "../../scripts/not-found-terminal";
</script>

<style>
  /* プロンプトの帯。右端を矢印の形に切り、2つ目からは左端を前の帯の矢印に合わせてへこませる */
  .segment {
    display: inline-flex;
    height: 1.7em;
    align-items: center;
    gap: 0.375rem;
    white-space: nowrap;
    font-size: 0.92em;
    font-weight: 600;
    clip-path: polygon(
      0 0,
      calc(100% - 9px) 0,
      100% 50%,
      calc(100% - 9px) 100%,
      0 100%
    );
  }

  .segment-next {
    clip-path: polygon(
      0 0,
      calc(100% - 9px) 0,
      100% 50%,
      calc(100% - 9px) 100%,
      0 100%,
      9px 50%
    );
  }

  .caret {
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
