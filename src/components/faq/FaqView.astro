---
// よくある質問ページの本体。sections は utils/faq.ts の toFaqSections で作ったもの（本番は microCMS、dev ページは固定データ）
import type { FaqSection } from "../../utils/faq";
import FaqCategoryNav from "./FaqCategoryNav.astro";
import FaqItem from "./FaqItem.astro";
import FaqMoreQuestions from "./FaqMoreQuestions.astro";

interface Props {
  sections: FaqSection[];
}

const { sections } = Astro.props;
---

<!-- カテゴリの行（lg 未満） -->
<div class="lg:hidden">
  <FaqCategoryNav sections={sections} variant="bar" />
</div>

<!-- 見出し -->
<section class="mx-auto max-w-[760px] px-5 pt-8 md:max-w-[784px] md:px-8 lg:max-w-[1184px] lg:pt-14">
  <p
    aria-hidden="true"
    class="font-['Rubik_Doodle_Shadow'] text-[32px] leading-none text-gray-900 lg:text-[40px]"
  >
    FAQ
  </p>
  <h1 class="mt-3 text-[26px] font-bold leading-[1.4] lg:mt-4 lg:text-[32px]">
    よくある質問
  </h1>
  <p class="mt-2.5 max-w-[640px] text-[15px] leading-[1.8] text-gray-600 lg:mt-3 lg:text-base">
    よくある質問をまとめました。ご不明な点がございましたら、お気軽にお問い合わせください。
  </p>
</section>

<!-- 質問の一覧 + 右の列（カテゴリ） -->
<div class="mx-auto flex max-w-[760px] items-start gap-20 px-5 pt-6 md:max-w-[784px] md:px-8 lg:max-w-[1184px] lg:pt-12">
  <div class="w-full min-w-0 max-w-[720px] flex-1">
    <div class="mb-2 flex justify-end">
      <button
        type="button"
        data-faq-toggle-all
        class="min-h-[44px] px-1 text-sm font-medium text-blue-600 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
      >
        すべて開く
      </button>
    </div>

    {sections.map((section) => (
      <section
        aria-labelledby={`cat-${section.slug}`}
        class="pt-10 first-of-type:pt-0 lg:pt-14"
      >
        <h2
          id={`cat-${section.slug}`}
          tabindex="-1"
          class="mb-2 flex items-baseline gap-2 text-[19px] font-bold leading-[1.5] focus:outline-none lg:mb-3 lg:gap-2.5 lg:text-[22px]"
        >
          {section.name}
          <span class="font-['Inter'] text-[13px] font-normal text-gray-500 lg:text-sm">
            {section.items.length}
            <span class="sr-only">件</span>
          </span>
        </h2>
        <div class="rounded-[14px] border border-gray-200 bg-white px-[18px] py-0.5 lg:px-7 lg:py-1">
          {section.items.map((item) => (
            <FaqItem item={item} />
          ))}
        </div>
      </section>
    ))}

    <FaqMoreQuestions />
  </div>

  <aside class="hidden w-[280px] shrink-0 pt-[52px] lg:block">
    <FaqCategoryNav sections={sections} variant="sidebar" />
  </aside>
</div>

<!-- JavaScript が動かないときは、閉じた回答を開けないので最初から表示する -->
<noscript>
  <style>
    [data-faq-answer] {
      display: block !important;
      content-visibility: visible !important;
    }
    [data-faq-toggle-all] {
      display: none;
    }
  </style>
</noscript>

<script>
  import "../../scripts/faq";
</script>
