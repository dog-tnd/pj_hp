---
import { getImageUrl, getAuthorImageUrl, type BlogPost } from "../lib/microcms";
import { formatDotDate } from "../utils/date";
import { sanitizeBlogHtml } from "../utils/sanitize";
import { convertInlineCode } from "../utils/inline-code";
import { highlightCodeBlocks } from "../utils/highlight";
import { buildToc } from "../utils/toc";
import ShareButtons from "./blog/ShareButtons.astro";
import TocList from "./blog/TocList.astro";

interface Props {
  post: BlogPost;
  prevPost?: { url: string; title: string };
  nextPost?: { url: string; title: string };
  relatedPosts?: Array<{
    url: string;
    title: string;
    description: string;
    image: string;
    date: string;
  }>;
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props as Props;

// 公開日（YYYY.MM.DD 形式）。microCMS の publishedAt を表示に使う
const publishedDate = formatDotDate(post.publishedAt);

// 記事の読了時間を計算（平均読速度: 400文字/分）
// microCMS の body は HTML なのでタグを除去してテキスト量を計算
let readingTime = 1;
try {
  const textContent = post.body
    .replace(/<[^>]+>/g, "") // HTML タグを除去
    .replace(/&[a-z]+;/gi, " ") // HTML エンティティを除去
    .replace(/\s+/g, " ")
    .trim();
  const wordCount = textContent.length;
  readingTime = Math.max(1, Math.round(wordCount / 400));
} catch (error) {
  console.warn("読了時間の計算に失敗しました:", error);
  const fallbackText = `${post.title} ${post.description}`;
  readingTime = Math.max(1, Math.round(fallbackText.length / 100));
}

// シェア・canonical 用 URL（本番の記事URLを指す）
const canonicalURL = new URL(`/blog/${post.id}`, Astro.site);
// 本文の整形: サニタイズ → インラインコード変換 → 目次 → コードブロックのハイライト。
// Shiki はインラインstyleで着色するため、必ずサニタイズより後に適用する
const toc = buildToc(convertInlineCode(sanitizeBlogHtml(post.body)));
const bodyHtml = await highlightCodeBlocks(toc.html);
// 見出しが2つ未満の記事では、目次（右の列・目次バー・目次ボタン）を出さない
const hasToc = toc.items.length >= 2;
---

<!--
  幅は lg 以上で 1120px（本文 720px ＋ 右の列）、md〜lg で 720px（中央寄せ）。
  Layout が <main> を持つので、ここでは <main> を使わない
-->
<div class="bg-white">
  <!-- 記事ヘッダー -->
  <header class="mx-auto max-w-[760px] px-5 pb-8 pt-6 md:max-w-[784px] md:px-8 md:pt-10 lg:max-w-[1184px] lg:pb-10 lg:pt-12">
    <nav aria-label="パンくずリスト" class="mb-7 hidden lg:block">
      <ol class="flex flex-wrap items-center gap-2 text-[13px] text-gray-500">
        <li class="flex items-center gap-2">
          <a href="/" class="hover:text-gray-900 hover:underline">
            ホーム
          </a>
          <span aria-hidden="true">/</span>
        </li>
        <li class="flex items-center gap-2">
          <a href="/blog" class="hover:text-gray-900 hover:underline">
            テックブログ
          </a>
          <span aria-hidden="true">/</span>
        </li>
        <li aria-current="page" class="text-gray-700">
          {post.title}
        </li>
      </ol>
    </nav>
    <a
      href="/blog"
      class="-ml-1 mb-2 inline-flex min-h-[44px] items-center gap-1 px-1 text-[13px] text-gray-500 hover:text-gray-900 lg:hidden"
    >
      <svg
        class="h-3.5 w-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
      テックブログ
    </a>

    {post.tags && post.tags.length > 0 && (
      <ul class="mb-4 flex flex-wrap gap-2 lg:mb-5" aria-label="タグ">
        {post.tags.map((tag) => (
          <li class="inline-flex h-7 items-center rounded-full bg-blue-50 px-3 text-[13px] font-medium text-blue-700">
            #{tag.name}
          </li>
        ))}
      </ul>
    )}

    <h1 class="max-w-[880px] text-[26px] font-bold leading-[1.5] text-gray-900 md:text-[34px] lg:text-[44px] lg:leading-[1.45]">
      {post.title}
    </h1>
    {post.description && (
      <p class="mt-3 max-w-[720px] text-[15px] leading-[1.8] text-gray-600 md:text-[17px] lg:mt-4 lg:text-lg">
        {post.description}
      </p>
    )}

    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-gray-200 pt-5 lg:mt-8 lg:pt-6">
      <div class="flex items-center gap-3">
        <img
          src={getAuthorImageUrl(post)}
          alt=""
          width="44"
          height="44"
          class="h-10 w-10 rounded-full object-cover lg:h-11 lg:w-11"
        />
        <p class="text-sm font-bold text-gray-900 lg:text-[15px]">
          {post.author}
          <span class="ml-1 text-xs font-normal text-gray-500 lg:text-[13px]">
            {post.role}
          </span>
        </p>
      </div>
      <span
        class="hidden h-8 w-px bg-gray-200 sm:block"
        aria-hidden="true"
      ></span>
      <p class="flex items-center gap-4 font-['Inter'] text-[13px] tabular-nums text-gray-600">
        {publishedDate && (
          <time datetime={post.publishedAt ?? undefined}>{publishedDate}</time>
        )}
        <span>{readingTime}分で読めます</span>
      </p>
    </div>
  </header>

  <div
    class:list={[
      "mx-auto flex max-w-[760px] items-start gap-20 px-5 md:max-w-[784px] md:px-8 lg:max-w-[1184px]",
      { "pb-16 lg:pb-24": !relatedPosts || relatedPosts.length === 0 },
    ]}
  >
    <article class="w-full min-w-0 max-w-[720px] flex-1">
      <!-- アイキャッチ（本文と同じ幅、16:9。スマホでは画面の端まで） -->
      <img
        src={getImageUrl(post)}
        alt=""
        width="1280"
        height="720"
        class="-mx-5 mb-10 aspect-video w-[calc(100%+2.5rem)] max-w-none bg-gray-100 object-cover md:mx-0 md:w-full md:rounded-xl lg:mb-14"
      />

      <!-- 記事本文（microCMS のリッチエディタ HTML）。見出しの着地位置は固定ヘッダー（と目次バー）の高さに合わせる -->
      <div
        class="prose prose-lg max-w-none prose-headings:scroll-mt-[72px] md:prose-headings:scroll-mt-[120px] lg:prose-headings:scroll-mt-[88px]"
        set:html={bodyHtml}
      />

      <!-- タグとシェア -->
      <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-y border-gray-200 py-7">
        {post.tags && post.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2" aria-label="タグ">
            {post.tags.map((tag) => (
              <li class="inline-flex h-7 items-center rounded-full bg-blue-50 px-3 text-[13px] font-medium text-blue-700">
                #{tag.name}
              </li>
            ))}
          </ul>
        )}
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-[13px] text-gray-500">シェア</span>
          <ShareButtons
            url={canonicalURL.href}
            title={post.title}
            variant="labeled"
          />
        </div>
      </div>

      <!-- 書いた人 -->
      <div class="mt-10 flex items-center gap-5 rounded-2xl bg-gray-50 p-5 md:p-7">
        <img
          src={getAuthorImageUrl(post)}
          alt=""
          width="64"
          height="64"
          class="h-14 w-14 shrink-0 rounded-full object-cover md:h-16 md:w-16"
        />
        <div class="leading-relaxed">
          <p class="font-['Inter'] text-xs tracking-[0.08em] text-gray-500">
            WRITTEN BY
          </p>
          <p class="text-base font-bold text-gray-900 md:text-lg">
            {post.author}
          </p>
          <p class="text-sm text-gray-600">{post.role}</p>
        </div>
      </div>

      <!-- 前後の記事。無い側は一覧へのリンクにする -->
      <nav
        aria-label="前後の記事"
        class="mt-10 grid gap-3 md:grid-cols-2 md:gap-4"
      >
        {prevPost ? (
          <a
            href={prevPost.url}
            class="flex flex-col gap-1.5 rounded-[14px] border border-gray-200 px-6 py-5 transition-colors hover:border-gray-300 hover:bg-gray-50"
          >
            <span class="flex items-center gap-1.5 text-[13px] text-gray-500">
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M15 18l-6-6 6-6"></path>
              </svg>
              前の記事
            </span>
            <span class="line-clamp-2 text-[15px] font-bold text-gray-900">
              {prevPost.title}
            </span>
          </a>
        ) : (
          <a
            href="/blog"
            class="flex items-center gap-1.5 rounded-[14px] border border-gray-200 px-6 py-5 text-[15px] font-bold text-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50"
          >
            <svg
              class="h-3.5 w-3.5 text-gray-500"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
            テックブログ一覧へ
          </a>
        )}
        {nextPost ? (
          <a
            href={nextPost.url}
            class="flex flex-col items-end gap-1.5 rounded-[14px] border border-gray-200 px-6 py-5 text-right transition-colors hover:border-gray-300 hover:bg-gray-50"
          >
            <span class="flex items-center gap-1.5 text-[13px] text-gray-500">
              次の記事
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6"></path>
              </svg>
            </span>
            <span class="line-clamp-2 text-[15px] font-bold text-gray-900">
              {nextPost.title}
            </span>
          </a>
        ) : (
          <a
            href="/blog"
            class="flex items-center justify-end gap-1.5 rounded-[14px] border border-gray-200 px-6 py-5 text-[15px] font-bold text-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50"
          >
            テックブログ一覧へ
            <svg
              class="h-3.5 w-3.5 text-gray-500"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M9 18l6-6-6-6"></path>
            </svg>
          </a>
        )}
      </nav>
    </article>

    <!-- 右の列（lg 以上）。アイキャッチの上端から始まり、スクロール後のヘッダー 64px ＋ 32px の位置で追従する -->
    <aside
      class="sticky top-24 hidden w-[280px] shrink-0 lg:block"
      aria-label="目次とシェア"
    >
      {hasToc && (
        <nav aria-label="目次">
          <p class="mb-3.5 font-['Inter'] text-xs tracking-[0.1em] text-gray-500">
            CONTENTS
          </p>
          <div class="max-h-[calc(100vh-96px-220px)] overflow-y-auto overscroll-contain">
            <TocList items={toc.items} variant="sidebar" />
          </div>
        </nav>
      )}
      <div class:list={["border-gray-200", { "mt-7 border-t pt-5": hasToc }]}>
        <p class="mb-3 font-['Inter'] text-xs tracking-[0.1em] text-gray-500">
          SHARE
        </p>
        <ShareButtons
          url={canonicalURL.href}
          title={post.title}
          variant="icon"
        />
      </div>
      <div class="mt-5 border-t border-gray-200 pt-3">
        <a
          href="#"
          class="inline-flex min-h-[44px] items-center gap-1.5 text-[13px] text-gray-600 hover:text-gray-900"
        >
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M12 19V5"></path>
            <path d="M5 12l7-7 7 7"></path>
          </svg>
          ページの先頭へ
        </a>
      </div>
    </aside>
  </div>

  <!-- 関連記事 -->
  {relatedPosts && relatedPosts.length > 0 && (
    <section
      aria-labelledby="related-heading"
      class="mt-16 bg-gray-50 py-10 lg:mt-28 lg:py-[72px]"
    >
      <div class="mx-auto max-w-[760px] md:max-w-[784px] md:px-8 lg:max-w-[1184px]">
        <div class="mb-4 flex items-baseline justify-between gap-4 px-5 md:px-0 lg:mb-7">
          <h2
            id="related-heading"
            class="text-xl font-bold text-gray-900 lg:text-2xl"
          >
            関連記事
          </h2>
          <a
            href="/blog"
            class="text-sm font-medium text-blue-600 hover:underline"
          >
            すべての記事を見る
          </a>
        </div>
        <ul class="flex gap-3 overflow-x-auto px-5 pb-1 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:px-0 md:pb-0">
          {relatedPosts.map((relatedPost) => (
            <li class="w-[260px] shrink-0 md:w-auto">
              <a
                href={relatedPost.url}
                class="flex h-full flex-col overflow-hidden rounded-[14px] border border-gray-200 bg-white transition-shadow hover:shadow-md"
              >
                <img
                  src={relatedPost.image}
                  alt=""
                  loading="lazy"
                  width="640"
                  height="360"
                  class="aspect-video w-full object-cover"
                />
                <span class="flex flex-col gap-2 px-5 pb-5 pt-4">
                  {relatedPost.date && (
                    <span class="font-['Inter'] text-xs tabular-nums text-gray-500">
                      {relatedPost.date}
                    </span>
                  )}
                  <span class="font-bold leading-relaxed text-gray-900">
                    {relatedPost.title}
                  </span>
                  {relatedPost.description && (
                    <span class="hidden md:block">
                      <span class="line-clamp-2 text-[13px] leading-[1.7] text-gray-600">
                        {relatedPost.description}
                      </span>
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- コピー結果の読み上げ用。ShareButtons が複数あってもページに1つだけ置く -->
  <p class="sr-only" aria-live="polite" data-copy-status></p>
</div>

<script>
  import "../scripts/article-toc";
</script>

<style>
  /* Markdownコンテンツのスタイリング */
  .prose {
    color: #374151;
  }
  .prose h2 {
    color: #111827;
    font-weight: 700;
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    scroll-margin-top: 5rem;
  }
  .prose h3 {
    color: #111827;
    font-weight: 600;
    font-size: 1.25rem;
    margin-top: 1.6rem;
    margin-bottom: 0.8rem;
    scroll-margin-top: 5rem;
  }
  .prose p {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .prose pre {
    background-color: #1f2937;
    color: #e5e7eb;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
  .prose code {
    color: #111827;
    font-weight: 600;
    font-size: 0.875em;
    background-color: #f3f4f6;
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
  }
  .prose pre code {
    color: inherit;
    background-color: transparent;
    padding: 0;
  }
  .prose img {
    border-radius: 0.5rem;
    margin: 2rem 0;
  }
  .prose blockquote {
    border-left: 4px solid #e5e7eb;
    padding-left: 1rem;
    font-style: italic;
    color: #6b7280;
  }
  .prose ul,
  .prose ol {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.625rem;
  }
  .prose li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
  }
  .prose th {
    background-color: #f9fafb;
    font-weight: 600;
    text-align: left;
    padding: 0.75rem;
    border-bottom: 2px solid #e5e7eb;
  }
  .prose td {
    padding: 0.75rem;
    border-bottom: 1px solid #e5e7eb;
  }

  /* ホバーエフェクト */
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 目次などのページ内リンクをなめらかに移動する。動きを減らす設定のときは即時に移動する */
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }
</style>
