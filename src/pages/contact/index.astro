---
import Layout from "../../layouts/Layout.astro";

// メールアドレスは HTML に平文で出さない（収集bot対策）。
// 表示は [at] 表記のまま、コピーだけ下のスクリプトで組み立てる。
const mailUser = "tokyorikanoda";
const mailDomain = "gmail.com";
---

<Layout
  title="お問い合わせ | プログラミングサークル TND"
  description="TNDへのお問い合わせ窓口です。入会・新歓についてはDiscordへご案内しています。イベントの共催や勉強会での登壇、取材のご依頼はメールかXのDMで受け付けています。"
  keywords={[
    "TND",
    "お問い合わせ",
    "東京理科大学",
    "プログラミングサークル",
    "協賛",
    "取材",
    "登壇",
  ]}
  canonicalURL="https://tus-tnd.com/contact/"
>
  <div class="mx-auto max-w-[1440px] px-20">
    <!-- ヒーロー -->
    <section class="grid grid-cols-[minmax(0,1fr)_480px] items-end gap-16 pt-[104px]">
      <div>
        <p class="text-sm font-medium tracking-[0.22em] text-gray-500">
          TOKYO UNIVERSITY OF SCIENCE / NODA CAMPUS
        </p>
        <p
          class="mt-5 text-[92px] leading-none text-blue-500"
          style="font-family: 'Rubik Doodle Shadow';"
        >
          CONTACT
        </p>
        <h1 class="mt-6 text-[30px] font-bold tracking-[0.04em] text-gray-900">
          お問い合わせ
        </h1>
      </div>
      <p class="text-lg leading-loose text-gray-600">
        入会・新歓についてのご質問は、ヘッダーの入会申し込みからDiscordへどうぞ。それ以外のご連絡は、こちらのメールかXのDMで受け付けています。
      </p>
    </section>

    <div class="pb-[120px] pt-24">
      <!-- 新入生向け -->
      <section class="grid grid-cols-[280px_minmax(0,1fr)] gap-14 border-t border-gray-200 py-[52px]">
        <div>
          <p
            class="text-[28px] leading-tight text-blue-500"
            style="font-family: 'Rubik Doodle Shadow';"
          >
            FOR NEWCOMERS
          </p>
          <h2 class="mt-2.5 text-2xl font-bold">入会・新歓について</h2>
        </div>
        <div>
          <p class="max-w-[640px] text-lg leading-[1.9] text-gray-600">
            新入生の方はDiscordへご案内しています。ページ上部の「入会申し込み」と同じ案内が開きます。
          </p>
          <!-- クリック処理は JoinDialog.astro が data-open-join を拾ってまとめて付ける -->
          <button
            type="button"
            data-open-join
            class="mt-[26px] inline-flex h-[52px] items-center justify-center rounded-full bg-[#F5BF48] px-7 text-base font-bold text-gray-900 shadow-[0_4px_8px_rgba(17,24,39,.12),0_12px_28px_rgba(245,191,72,.34)] transition-colors hover:bg-[#E9AF2E]"
          >
            入会申し込み
          </button>
        </div>
      </section>

      <!-- 外部の方向け -->
      <section class="grid grid-cols-[280px_minmax(0,1fr)] gap-14 border-t border-gray-200 pt-[52px]">
        <div>
          <p
            class="text-[28px] leading-tight text-blue-500"
            style="font-family: 'Rubik Doodle Shadow';"
          >
            FOR VISITORS
          </p>
          <h2 class="mt-2.5 text-2xl font-bold">外部の皆様へ</h2>
        </div>
        <div>
          <p class="max-w-[640px] text-lg leading-[1.9] text-gray-600">
            TNDに興味をお持ちいただきありがとうございます。イベントの共催や勉強会での登壇、取材のご依頼など、企業・他団体の皆様からのご相談をお受けしています。まずはお気軽にご連絡ください。
          </p>

          <div class="mt-7 flex gap-5">
            <div class="flex-1 rounded-[14px] border border-gray-200 bg-white px-7 py-[26px]">
              <p class="text-sm font-medium tracking-[0.18em] text-gray-500">
                EMAIL
              </p>
              <p class="mt-3 text-xl font-bold">
                {mailUser}[at]{mailDomain}
              </p>
              <button
                type="button"
                data-copy-mail
                data-mail-user={mailUser}
                data-mail-domain={mailDomain}
                class="mt-[18px] inline-flex h-11 items-center gap-2 rounded-[10px] border border-blue-500 bg-white px-[18px] text-sm font-bold text-blue-700 transition-colors hover:bg-blue-50"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                  <path
                    d="M5 15V5a2 2 0 0 1 2-2h10"
                    stroke-linecap="round"
                  ></path>
                </svg>
                <span data-copy-label>アドレスをコピー</span>
              </button>
              <p class="mt-3.5 text-sm leading-[1.7] text-gray-500">
                迷惑メール対策のため、記号を置き換えて表示しています。
              </p>
            </div>

            <div class="flex-1 rounded-[14px] border border-gray-200 bg-white px-7 py-[26px]">
              <p class="text-sm font-medium tracking-[0.18em] text-gray-500">
                X (TWITTER) DM
              </p>
              <p class="mt-3 text-xl font-bold">@TokyorikaND</p>
              <a
                href="https://x.com/TokyorikaND"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-[18px] inline-flex h-11 items-center gap-2 rounded-[10px] border border-blue-500 bg-white px-[18px] text-sm font-bold text-blue-700 transition-colors hover:bg-blue-50"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M4 4L20 20M20 4L4 20" stroke-linecap="round"></path>
                </svg>
                DMを送る
              </a>
              <p class="mt-3.5 text-sm leading-[1.7] text-gray-500">
                急ぎのご連絡はこちらが早く届きます。
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <footer class="mt-24 border-t border-gray-200 py-8">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm text-gray-500">© 2026 TND All Rights Reserved.</p>
    </div>
  </footer>
</Layout>

<script>
  // 表示は [at] のまま。コピーするときだけ実アドレスを組み立てる。
  const AT = String.fromCharCode(64);

  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-mail]")
    .forEach((button) => {
      const label = button.querySelector<HTMLElement>("[data-copy-label]");
      if (!label) return;
      const original = label.textContent ?? "";
      let timer: number | undefined;

      button.addEventListener("click", async () => {
        const { mailUser, mailDomain } = button.dataset;
        if (!mailUser || !mailDomain) return;

        try {
          await navigator.clipboard.writeText(mailUser + AT + mailDomain);
          label.textContent = "コピーしました";
        } catch {
          // クリップボードが使えない環境（権限拒否・http 接続など）では実アドレスを表示して手で選べるようにする
          label.textContent = mailUser + AT + mailDomain;
        }

        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          label.textContent = original;
        }, 2000);
      });
    });
</script>
