---
import Layout from "../../layouts/Layout.astro";
import {
  getAllPosts,
  getAuthorImageUrl,
  getImageUrl,
} from "../../lib/microcms";
import { formatDotDate } from "../../utils/date";
import "../../styles/about.css";

// 写真は public/about/ に配置し、対応する値を "/about/写真名.jpg" に変更する。
// 空文字の枠はダミーを表示する。
const aboutPhotos = {
  hero: "/about/hero.jpg",
  activities: {
    internalHackathon: "/about/activityhackathonin.jpg",
    externalHackathon: "/about/activityhackathonout.jpg",
    social: "/about/activitysocial.jpg",
  },
  community: { presentation: "", work: "/about/MTG.png", social: "" },
  voices: { web: "/about/memberA.png", data: "/about/memberB.png" },
  companies: "/about/partners.jpg",
};

const activities = [
  {
    number: "01",
    en: "HACKATHON",
    title: "ハッカソン",
    description:
      "サークル内で開発イベントを開きます。短期間でチームを組み、動くものをつくって発表します。",
    photo: aboutPhotos.activities.internalHackathon,
  },
  {
    number: "02",
    en: "COMPETITION",
    title: "外部コンテスト",
    description:
      "Kaggleをはじめとするデータ分析コンペティションに、チームを編成して参加しています。近年はAIエージェントの開発にも取り組んでいます。",
    photo: aboutPhotos.activities.externalHackathon,
  },
  {
    number: "03",
    en: "SOCIAL",
    title: "ソーシャルイベント",
    description:
      "BBQ・懇親会・LT会など。つくる時間と同じくらい、話す時間を大切にしています。",
    photo: aboutPhotos.activities.social,
  },
];

const teams = [
  {
    en: "WEB DEVELOPMENT",
    title: "ウェブ開発",
    tags: [
      "HTML / CSS",
      "TypeScript",
      "React / Next.js",
      "Node.js",
      "Go",
      "Python",
    ],
  },
  {
    en: "DATA SCIENCE",
    title: "データサイエンス",
    tags: [
      "Python",
      "pandas",
      "scikit-learn",
      "PyTorch",
      "データ分析",
      "可視化",
      "機械学習",
      "深層学習",
      "統計",
      "Kaggle",
      "AIエージェント",
    ],
  },
];

const steps = [
  {
    number: "01",
    title: "入会申し込み",
    description:
      "「入会申し込み」のボタンから、Discordへの参加方法を確認します。",
  },
  {
    number: "02",
    title: "Discord に参加",
    description:
      "サーバーに入って自己紹介をします。普段のやりとりもここで行います。",
  },
  {
    number: "03",
    title: "チームを選んで活動",
    description: "ウェブ開発かデータサイエンスを選びます。掛け持ちもできます。",
  },
];

const posts = (await getAllPosts()).slice(0, 3);
---

<Layout
  title="私たちについて | プログラミングサークル TND"
  description="東京理科大学野田キャンパスのプログラミングサークルTND。ウェブ開発とデータサイエンスの2チームで、ハッカソンやチーム開発に取り組みます。会費は年間4,000円、メンバーは通年で募集しています。"
>
  <div class="about-page">
    <section
      id="about"
      class="about-hero about-shell"
      aria-labelledby="about-title"
    >
      <div class="about-hero-copy">
        <p class="about-eyebrow">TOKYO UNIVERSITY OF SCIENCE / NODA CAMPUS</p>
        <h1 id="about-title" class="about-display about-hero-title">
          ABOUT
        </h1>
        <p class="about-hero-lead">
          <span class="about-hero-university">東京理科大学</span>{" "}
          野田キャンパスの
          <br />
          プログラミングサークル
        </p>
        <p class="about-hero-description">
          TNDは2024年に設立したプログラミングサークルです。ウェブ開発とデータサイエンスの2つのチームで、ハッカソンやチーム開発に取り組んでいます。
        </p>
      </div>
      <div class="about-hero-art">
        {aboutPhotos.hero ? (
          <img
            src={aboutPhotos.hero}
            alt="仲間とプログラミングに取り組むイメージ"
            width="1329"
            height="1208"
            loading="eager"
            decoding="async"
          />
        ) : (
          <span class="about-photo-empty">メンバーの活動写真</span>
        )}
      </div>
    </section>

    <section
      id="activities"
      class="about-section about-activities"
      aria-labelledby="activities-title"
    >
      <div class="about-shell about-split">
        <div class="about-section-heading">
          <h2 id="activities-title" class="about-display">
            ACTIVITIES
          </h2>
          <p>活動</p>
        </div>
        <div class="about-section-content">
          <p class="about-section-intro">
            ハッカソン・外部コンテスト・ソーシャルイベントの3つを軸に活動しています。普段のやりとりはDiscordで行っています。
          </p>
          <div class="about-activity-list">
            {activities.map((activity) => (
              <article class="about-activity-card">
                <div class="about-activity-copy">
                  <span class="about-overline">
                    {activity.number} · {activity.en}
                  </span>
                  <h3>{activity.title}</h3>
                  <p>{activity.description}</p>
                </div>
                <div class="about-activity-art">
                  {activity.photo ? (
                    <img
                      src={activity.photo}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="about-photo-empty">活動の写真</span>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section
      id="community"
      class="about-section about-community"
      aria-labelledby="community-title"
    >
      <div class="about-shell">
        <div class="about-split about-section-top">
          <div class="about-section-heading">
            <h2 id="community-title" class="about-display">
              COMMUNITY
            </h2>
            <p>普段の様子</p>
          </div>
          <p class="about-section-intro">
            普段のコミュニケーションはDiscordで取っています。わからないことの相談も、つくったものの共有も、イベントの告知も、ここに集まります。
          </p>
        </div>
        <div class="about-community-grid">
          <div class="about-discord-card">
            <svg
              viewBox="0 0 24 24"
              width="24"
              height="24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6 7.5c3.6-2 8.4-2 12 0l2 8.5c-1.3 1.2-3 2-4.7 2.5l-1-1.5c-1.5.3-3.1.3-4.6 0l-1 1.5C7 18 5.3 17.2 4 16l2-8.5Z" />
              <circle
                cx="9.5"
                cy="12.5"
                r=".7"
                fill="currentColor"
                stroke="none"
              />
              <circle
                cx="14.5"
                cy="12.5"
                r=".7"
                fill="currentColor"
                stroke="none"
              />
            </svg>
            <span class="about-overline">ON DISCORD</span>
            <h3>
              Discordで
              <br />
              つながっています
            </h3>
            <ul>
              <li>質問・相談</li>
              <li>進捗の共有</li>
              <li>イベントの告知</li>
              <li>雑談</li>
            </ul>
            <p class="about-discord-note">参加は「入会申し込み」のボタンから</p>
          </div>
          <div class="about-community-photo about-community-photo-main">
            {aboutPhotos.community.presentation ? (
              <img
                src={aboutPhotos.community.presentation}
                alt="ハッカソンの発表の様子"
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <span>写真：ハッカソンの発表</span>
          </div>
          <div class="about-community-photo about-community-photo-work">
            {aboutPhotos.community.work ? (
              <img
                src={aboutPhotos.community.work}
                alt="作業の様子"
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <span>写真：作業の様子</span>
          </div>
          <div class="about-community-photo about-community-photo-social">
            {aboutPhotos.community.social ? (
              <img
                src={aboutPhotos.community.social}
                alt="BBQの様子"
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <span>写真：BBQ</span>
          </div>
        </div>
      </div>
    </section>

    <section
      id="teams"
      class="about-section about-teams"
      aria-labelledby="teams-title"
    >
      <div class="about-shell about-split">
        <div class="about-section-heading">
          <h2 id="teams-title" class="about-display">
            TEAMS
          </h2>
          <p>チーム</p>
        </div>
        <div class="about-section-content">
          <p class="about-section-intro">
            2つのチームに分かれて活動します。掛け持ちも、途中で移ることもできます。
          </p>
          <div class="about-team-list">
            {teams.map((team) => (
              <article class="about-team-card">
                <span class="about-overline">{team.en}</span>
                <h3>{team.title}</h3>
                <ul class="about-tag-list">
                  {team.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="voices" class="about-voices" aria-labelledby="voices-title">
      <div class="about-shell">
        <div class="about-section-heading">
          <h2 id="voices-title" class="about-display">
            VOICES
          </h2>
          <p>メンバーの声</p>
        </div>
        <div class="about-voice-grid">
          <blockquote class="about-voice-card">
            <div class="about-voice-avatar">
              {aboutPhotos.voices.web && (
                <img
                  src={aboutPhotos.voices.web}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <div>
              <p>
                「授業では触れない部分を、先輩に聞きながら進められました。半年でひとつサイトを公開できたのが自信になっています。」
              </p>
              <footer>
                <strong>Aさん</strong>
                <span>2年・ウェブ開発チーム</span>
              </footer>
            </div>
          </blockquote>
          <blockquote class="about-voice-card">
            <div class="about-voice-avatar">
              {aboutPhotos.voices.data && (
                <img
                  src={aboutPhotos.voices.data}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <div>
              <p>
                「内部ハッカソンで初めてチーム開発をしました。役割を分けて動かす難しさは、ひとりでは経験できませんでした。」
              </p>
              <footer>
                <strong>Bさん</strong>
                <span>3年・データサイエンスチーム</span>
              </footer>
            </div>
          </blockquote>
        </div>
      </div>
    </section>

    <section
      id="tech-blog"
      class="about-section about-blog about-shell"
      aria-labelledby="blog-title"
    >
      <div class="about-section-heading">
        <h2 id="blog-title" class="about-display">
          TECH BLOG
        </h2>
        <p>テックブログの最新記事</p>
      </div>
      {posts.length > 0 ? (
        <div class="about-blog-grid">
          {posts.map((post, index) => (
            <article
              class:list={[
                "about-blog-card",
                { "about-blog-card-featured": index === 0 },
              ]}
            >
              <a
                class="about-blog-image"
                href={`/blog/${post.id}`}
                aria-label={`${post.title}を読む`}
              >
                {post.image?.url ? (
                  <img
                    src={getImageUrl(post)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span>記事のサムネイル（microCMS）</span>
                )}
                {index === 0 && <span class="about-new-badge">NEW</span>}
                <span class="about-blog-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </a>
              <div class="about-blog-copy">
                <div class="about-blog-meta">
                  {post.tags?.[0] && (
                    <span class="about-blog-tag">#{post.tags[0].name}</span>
                  )}
                  <time datetime={post.publishedAt ?? undefined}>
                    {formatDotDate(post.publishedAt)}
                  </time>
                </div>
                <h3>
                  <a href={`/blog/${post.id}`}>{post.title}</a>
                </h3>
                {index === 0 && (
                  <p class="about-blog-description">{post.description}</p>
                )}
                <div class="about-blog-author">
                  {index === 0 && (
                    <img
                      src={getAuthorImageUrl(post)}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span>
                    {post.author}・{post.role}
                  </span>
                </div>
              </div>
            </article>
          ))}
          <a class="about-blog-more" href="/blog">
            <span class="about-terminal-dots" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </span>
            <span class="about-terminal-code" aria-hidden="true">
              ~/tnd
              <br />
              <b>❯</b> cd blog
              <br />
              <b>❯</b> ls ▍
            </span>
            <span class="about-blog-more-label">
              記事の一覧を見る <span aria-hidden="true">→</span>
            </span>
          </a>
        </div>
      ) : (
        <p class="about-blog-empty">
          記事は準備中です。<a href="/blog">テックブログを見る</a>
        </p>
      )}
    </section>

    <section
      id="join"
      class="about-section about-join"
      aria-labelledby="join-title"
    >
      <div class="about-shell about-split">
        <div class="about-section-heading">
          <h2 id="join-title" class="about-display">
            HOW TO JOIN
          </h2>
          <p>参加方法</p>
        </div>
        <div class="about-section-content">
          <p class="about-section-intro">
            メンバーは通年で募集しています。学年や経験は問いません。
          </p>
          <ol class="about-steps">
            {steps.map((step) => (
              <li>
                <span class="about-step-dot" aria-hidden="true"></span>
                <span class="about-overline">STEP {step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </li>
            ))}
          </ol>
          <div class="about-join-details">
            <div>
              <small>会費</small>
              <p>
                <strong>半期 2,000円</strong>
                <span>（年 4,000円）</span>
              </p>
            </div>
            <div>
              <small>経験</small>
              <p>
                メンバーの <strong>9割</strong> が大学からのスタート
              </p>
            </div>
            <button class="about-join-button" type="button" data-open-join>
              入会申し込み
            </button>
          </div>
        </div>
      </div>
    </section>

    <section
      id="companies"
      class="about-section about-companies"
      aria-labelledby="companies-title"
    >
      <div class="about-shell about-split">
        <div class="about-section-heading">
          <h2 id="companies-title" class="about-display">
            FOR COMPANIES
          </h2>
          <p>企業の方へ</p>
        </div>
        <div class="about-company-card">
          <div class="about-company-copy">
            <p>
              協賛、イベントの共催、勉強会での登壇などのご相談を受け付けています。ウェブ開発とデータサイエンスの2つのチームに、約20名が所属しています。
            </p>
            <a href="/contact">
              お問い合わせページへ <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="about-company-art">
            {aboutPhotos.companies ? (
              <img
                src={aboutPhotos.companies}
                alt="企業の方と学生が話し合うイメージ"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="about-photo-empty">企業の方との活動写真</span>
            )}
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
