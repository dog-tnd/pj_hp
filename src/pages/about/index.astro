---
import Layout from "../../layouts/Layout.astro";
import {
  getAllPosts,
  getAuthorImageUrl,
  getImageUrl,
} from "../../lib/microcms";
import { formatDotDate } from "../../utils/date";

// 写真は public/about/ に配置し、対応する値を "/about/写真名.jpg" に変更する。
// 空文字の枠は斜線のダミーを表示する。
const aboutPhotos = {
  hero: "",
  activities: {
    study: "",
    internalHackathon: "",
    externalHackathon: "",
    social: "",
  },
  teams: { web: "", design: "", data: "" },
  reasons: { learn: "", grow: "", experience: "" },
  voices: { design: "", data: "" },
  join: "",
  companies: "",
};

const activities = [
  {
    number: "01",
    title: "勉強会",
    description:
      "基礎から応用まで、定期的に開催しています。はじめてプログラミングに触れる人も、そこから学べます。",
    label: "学びを共有する時間",
    photo: aboutPhotos.activities.study,
  },
  {
    number: "02",
    title: "内部ハッカソン",
    description:
      "年2回、サークル内で開発コンペを行います。短期間でチームを組み、動くものをつくって発表します。",
    label: "チームで形にする",
    photo: aboutPhotos.activities.internalHackathon,
  },
  {
    number: "03",
    title: "外部ハッカソン",
    description:
      "有志で企業主催のイベントに参加します。学外の開発者と同じ場で手を動かす機会です。",
    label: "学外へ挑戦する",
    photo: aboutPhotos.activities.externalHackathon,
  },
  {
    number: "04",
    title: "ソーシャルイベント",
    description:
      "BBQ、懇親会、LT会。つくる時間と同じくらい、話す時間を大切にしています。",
    label: "仲間とつながる",
    photo: aboutPhotos.activities.social,
  },
];

const teams = [
  {
    en: "WEB",
    title: "ウェブ開発",
    tags: [
      "HTML/CSS",
      "TypeScript",
      "React / Next.js",
      "Python",
      "Go",
      "Node.js",
    ],
    label: "アイデアを動くサービスに",
    photo: aboutPhotos.teams.web,
  },
  {
    en: "DESIGN",
    title: "デザイン",
    tags: ["UI/UX", "Figma"],
    label: "使いたくなる体験をつくる",
    photo: aboutPhotos.teams.design,
  },
  {
    en: "DATA",
    title: "データサイエンス",
    tags: ["データ分析", "可視化", "機械学習"],
    label: "データから発見を生み出す",
    photo: aboutPhotos.teams.data,
  },
];

const reasons = [
  {
    number: "01",
    title: "実践で学ぶ",
    description:
      "教科書を読むだけで終わらせず、実際に動くものをつくりながら覚えます。",
    label: "手を動かして、理解を深める",
    photo: aboutPhotos.reasons.learn,
  },
  {
    number: "02",
    title: "仲間と成長する",
    description:
      "つまずいたところを持ち寄れる相手がいます。教える側にまわると理解が深まります。",
    label: "一緒につくる楽しさ",
    photo: aboutPhotos.reasons.grow,
  },
  {
    number: "03",
    title: "経験を積む",
    description:
      "ハッカソンや企業のイベントで、学外の人に見てもらう機会があります。",
    label: "新しい挑戦のきっかけ",
    photo: aboutPhotos.reasons.experience,
  },
];

const steps = [
  {
    number: "01",
    title: "募集開始",
    description: "4月、新歓の告知を各SNSと学内掲示で出します。",
  },
  {
    number: "02",
    title: "説明会に参加",
    description:
      "活動内容と1年間の流れを説明します。話を聞くだけの参加もできます。",
  },
  {
    number: "03",
    title: "参加申し込み",
    description: "フォームから申し込み。その週から活動に加わってもらえます。",
  },
];
const posts = (await getAllPosts()).slice(0, 3);
---

<Layout
  title="私たちについて | プログラミングサークル TND"
  description="東京理科大学野田キャンパスのプログラミングサークルTND。ウェブ開発・デザイン・データサイエンスの3班で学び、ハッカソンやチーム開発に取り組みます。会費は年間4,000円、募集は毎年4〜5月です。"
>
  <div class="about-page">
    <section
      id="about"
      class="hero section-shell"
      aria-labelledby="about-title"
    >
      <div class="hero-copy">
        <p class="eyebrow">TOKYO UNIVERSITY OF SCIENCE / NODA CAMPUS</p>
        <h1 id="about-title" class="hero-title">
          ABOUT TND
        </h1>
        <p class="hero-lead">
          つくりながら学ぶ、
          <br />
          学生のプログラミングサークル。
        </p>
        <p class="hero-description">
          TNDは東京理科大学野田キャンパスのプログラミングサークルです。2024年に設立し、現在は約20名のメンバーがウェブ開発・デザイン・データサイエンスに取り組んでいます。
        </p>
        <dl class="stats">
          <div>
            <dt>2024</dt>
            <dd>設立</dd>
          </div>
          <div>
            <dt>20</dt>
            <dd>メンバー（名）</dd>
          </div>
          <div>
            <dt>3</dt>
            <dd>活動分野</dd>
          </div>
        </dl>
      </div>
      <div
        class="hero-art illustration"
        role={aboutPhotos.hero ? undefined : "img"}
        aria-label={
          aboutPhotos.hero
            ? undefined
            : "メンバーがアイデアを形にする活動のイメージ"
        }
      >
        {aboutPhotos.hero ? (
          <img
            src={aboutPhotos.hero}
            alt="メンバーがアイデアを形にする活動"
            loading="eager"
            decoding="async"
          />
        ) : (
          <span class="art-caption">LEARN, MAKE, GROW TOGETHER.</span>
        )}
      </div>
      <p class="art-direction">
        一人ひとりの「つくりたい」を、仲間と一緒に形にする場所。学年や経験にかかわらず、好奇心から始められます。
      </p>
    </section>

    <section
      id="activities"
      class="activities section-band"
      aria-labelledby="activities-title"
    >
      <div class="section-shell">
        <div class="section-heading heading-row">
          <div>
            <h2 id="activities-title" class="en-heading">
              ACTIVITIES
            </h2>
            <p class="ja-heading">活動</p>
          </div>
          <p class="heading-note">
            学ぶ・つくる・出会う・集まる。
            <br />
            4種類の活動を年間を通して行っています。
          </p>
        </div>
        <div class="activity-list">
          {activities.map((activity) => (
            <article class="activity-card">
              <span class="activity-number">{activity.number}</span>
              <div class="activity-copy">
                <h3>{activity.title}</h3>
                <p>{activity.description}</p>
              </div>
              <div
                class="activity-art illustration"
                role={activity.photo ? undefined : "img"}
                aria-label={activity.photo ? undefined : activity.label}
              >
                {activity.photo ? (
                  <img
                    src={activity.photo}
                    alt={activity.label}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="art-caption">{activity.label}</span>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      id="tech-blog"
      class="blog-section section-shell"
      aria-labelledby="blog-title"
    >
      <div class="section-heading heading-row">
        <div>
          <h2 id="blog-title" class="en-heading">
            TECH BLOG
          </h2>
          <p class="ja-heading">テックブログ最新記事</p>
        </div>
        <a class="text-link" href="/blog">
          記事の一覧を見る <span aria-hidden="true">↗</span>
        </a>
      </div>
      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post) => (
            <article class="blog-card">
              <a
                class="blog-image-link"
                href={`/blog/${post.id}`}
                aria-label={`${post.title}を読む`}
              >
                <img src={getImageUrl(post)} alt="" loading="lazy" />
              </a>
              <h3>
                <a href={`/blog/${post.id}`}>{post.title}</a>
              </h3>
              <p class="blog-description">{post.description}</p>
              <div class="blog-meta">
                <img src={getAuthorImageUrl(post)} alt="" loading="lazy" />
                <div class="blog-author">
                  <strong>{post.author}</strong>
                  <span>{post.role}</span>
                </div>
                <time datetime={post.publishedAt ?? undefined}>
                  {post.publishedAt ? formatDotDate(post.publishedAt) : ""}
                </time>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-posts">
          記事は準備中です。<a href="/blog">テックブログを見る</a>
        </p>
      )}
    </section>

    <section
      id="teams"
      class="teams section-shell"
      aria-labelledby="teams-title"
    >
      <div class="section-heading">
        <h2 id="teams-title" class="en-heading">
          TEAMS
        </h2>
        <p class="ja-heading">チーム</p>
        <p class="section-intro">
          3つの班に分かれて活動します。掛け持ちも、途中で移ることもできます。
        </p>
      </div>
      <div class="team-list">
        {teams.map((team) => (
          <article class="team-card">
            <div class="team-title">
              <span class="small-en">{team.en}</span>
              <h3>{team.title}</h3>
            </div>
            <ul class="tag-list">
              {team.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <div
              class="team-art illustration"
              role={team.photo ? undefined : "img"}
              aria-label={team.photo ? undefined : team.label}
            >
              {team.photo ? (
                <img
                  src={team.photo}
                  alt={team.label}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="art-caption">{team.label}</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section
      id="why-join"
      class="reasons section-shell"
      aria-labelledby="why-title"
    >
      <div class="section-heading">
        <h2 id="why-title" class="en-heading">
          WHY JOIN
        </h2>
        <p class="ja-heading">TNDに参加する理由</p>
      </div>
      <div class="reasons-grid">
        {reasons.map((reason) => (
          <article class="reason-card">
            <div
              class="reason-art illustration"
              role={reason.photo ? undefined : "img"}
              aria-label={reason.photo ? undefined : reason.label}
            >
              {reason.photo ? (
                <img
                  src={reason.photo}
                  alt={reason.label}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="art-caption">{reason.label}</span>
              )}
            </div>
            <span class="reason-number">{reason.number}</span>
            <h3>{reason.title}</h3>
            <p>{reason.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section
      id="voices"
      class="voices section-band"
      aria-labelledby="voices-title"
    >
      <div class="section-shell">
        <div class="section-heading">
          <h2 id="voices-title" class="en-heading">
            VOICES
          </h2>
          <p class="ja-heading">メンバーの声</p>
        </div>
        <div class="voice-grid">
          <blockquote class="voice-card">
            <div class="voice-avatar illustration" aria-hidden="true">
              {aboutPhotos.voices.design && (
                <img
                  src={aboutPhotos.voices.design}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <div>
              <p>
                「授業では触れない部分を、先輩に聞きながら進められました。半年でひとつサイトを公開できたのが自信になっています。」
              </p>
              <footer>
                <strong>高橋 結衣</strong>
                <span>2年・デザイン班</span>
              </footer>
            </div>
          </blockquote>
          <blockquote class="voice-card">
            <div class="voice-avatar illustration" aria-hidden="true">
              {aboutPhotos.voices.data && (
                <img
                  src={aboutPhotos.voices.data}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <div>
              <p>
                「内部ハッカソンで初めてチーム開発をしました。役割を分けて動かす難しさは、ひとりでは経験できませんでした。」
              </p>
              <footer>
                <strong>井上 蓮</strong>
                <span>3年・データサイエンス班</span>
              </footer>
            </div>
          </blockquote>
        </div>
      </div>
    </section>

    <section id="join" class="join section-shell" aria-labelledby="join-title">
      <div class="join-top">
        <div class="section-heading">
          <h2 id="join-title" class="en-heading">
            HOW TO JOIN
          </h2>
          <p class="ja-heading">参加方法</p>
          <p class="section-intro">
            募集は毎年4〜5月に行っています。学年や経験は問いません。
          </p>
          <span class="recruit-badge">募集期間 4〜5月</span>
        </div>
        <div
          class="join-art illustration"
          role={aboutPhotos.join ? undefined : "img"}
          aria-label={
            aboutPhotos.join
              ? undefined
              : "新しい仲間と一緒に活動を始めるイメージ"
          }
        >
          {aboutPhotos.join ? (
            <img
              src={aboutPhotos.join}
              alt="新しい仲間と一緒に活動を始める様子"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="art-caption">ここから、一緒にはじめよう。</span>
          )}
        </div>
      </div>
      <ol class="steps">
        {steps.map((step) => (
          <li>
            <span class="step-dot" aria-hidden="true"></span>
            <span class="step-label">STEP {step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
      <div class="join-details">
        <div>
          <small>会費</small>
          <p>
            <strong>半期 2,000円</strong>
            <span>年間 4,000円</span>
          </p>
        </div>
        <div>
          <small>経験</small>
          <p>
            <strong>9割</strong>
            <span>が大学からのスタート</span>
          </p>
        </div>
        <a class="blue-button" href="/contact">
          お問い合わせ
        </a>
      </div>
    </section>

    <section
      id="companies"
      class="companies section-shell"
      aria-labelledby="companies-title"
    >
      <div class="company-card">
        <div>
          <div class="section-heading">
            <h2 id="companies-title" class="en-heading">
              FOR COMPANIES
            </h2>
            <p class="ja-heading">企業の方へ</p>
          </div>
          <p>
            協賛、イベントの共催、勉強会での登壇についてご相談を受け付けています。ウェブ開発・デザイン・データサイエンスの3班、約20名が在籍しています。まずは概要をお送りください。担当者より折り返しご連絡します。
          </p>
          <div class="company-contact">
            <a class="blue-button" href="/contact">
              企業の方のお問い合わせ
            </a>
            <span>お問い合わせフォームからご連絡ください</span>
          </div>
        </div>
        <div
          class="company-art illustration"
          role={aboutPhotos.companies ? undefined : "img"}
          aria-label={
            aboutPhotos.companies ? undefined : "企業と学生が協力するイメージ"
          }
        >
          {aboutPhotos.companies ? (
            <img
              src={aboutPhotos.companies}
              alt="企業と学生が協力する様子"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="art-caption">学びと社会をつなぐ</span>
          )}
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-page {
    color: #111827;
    background: #f9fafb;
    font-family: "Noto Sans JP", sans-serif;
  }
  .section-shell {
    width: min(100% - 80px, 1120px);
    margin-inline: auto;
  }
  .section-band {
    background: #eff6ff;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.9fr);
    column-gap: 6%;
    padding-top: 64px;
    padding-bottom: 72px;
    position: relative;
    background: radial-gradient(
      ellipse 55% 75% at 100% 0%,
      rgba(45, 212, 191, 0.12) 0%,
      rgba(59, 130, 246, 0.2) 42%,
      rgba(59, 130, 246, 0) 100%
    );
  }
  .eyebrow,
  .step-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: #4b5563;
  }
  .hero-title,
  .en-heading,
  .small-en,
  .activity-number,
  .reason-number,
  .stats dt {
    font-family: "Rubik Doodle Shadow", sans-serif;
  }
  .hero-title {
    font-size: clamp(44px, 5.4vw, 76px);
    line-height: 1.15;
    letter-spacing: 0.015em;
    margin: 20px 0 12px;
  }
  .hero-lead {
    font-size: clamp(23px, 2.4vw, 32px);
    line-height: 1.55;
    letter-spacing: 0.025em;
    font-weight: 700;
    margin: 0 0 22px;
  }
  .hero-description {
    font-size: 14px;
    line-height: 2;
    color: #4b5563;
    max-width: 590px;
    margin: 0;
  }
  .stats {
    display: flex;
    gap: 34px;
    border-top: 1px solid #e5e7eb;
    margin: 35px 0 0;
    padding-top: 20px;
  }
  .stats div {
    min-width: 100px;
  }
  .stats dt {
    font-size: 32px;
    color: #3b82f6;
    line-height: 1.15;
  }
  .stats dt span {
    font-size: 20px;
  }
  .stats dd {
    margin: 3px 0 0;
    font-size: 11px;
    color: #4b5563;
  }
  .illustration {
    background: repeating-linear-gradient(
      135deg,
      #e4efff 0,
      #e4efff 5px,
      #fff 5px,
      #fff 12px
    );
    border: 1px solid #dbeafe;
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }
  .illustration > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art-caption {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: block;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 5px;
    padding: 7px 9px;
    font-size: 10px;
    line-height: 1.5;
    color: #4b5563;
  }
  .hero-art {
    height: 340px;
    align-self: center;
  }
  .hero-art .art-caption {
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .art-direction {
    grid-column: 1/-1;
    margin: 62px 0 0;
    padding: 17px 20px;
    border: 1px dashed #d6e4f4;
    border-radius: 9px;
    background: #fff;
    color: #4b5563;
    font-size: 12px;
    line-height: 1.8;
  }
  .section-heading {
    margin-bottom: 38px;
  }
  .heading-row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .en-heading {
    font-weight: 400;
    font-size: clamp(31px, 3vw, 42px);
    line-height: 1.2;
    color: #3b82f6;
    margin: 0 0 4px;
  }
  .ja-heading {
    font-size: 23px;
    font-weight: 700;
    line-height: 1.5;
    margin: 0;
  }
  .heading-note {
    font-size: 12px;
    line-height: 1.8;
    color: #4b5563;
    text-align: right;
    margin: 0;
  }
  .activities {
    padding: 80px 0 90px;
  }
  .activity-list {
    display: grid;
    gap: 16px;
  }
  .activity-card {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) 210px;
    align-items: center;
    gap: 24px;
    min-height: 156px;
    background: #fff;
    border: 1px solid #dce5f1;
    border-radius: 12px;
    padding: 18px 24px;
  }
  .activity-number {
    font-size: 32px;
    color: #3b82f6;
  }
  .activity-copy h3,
  .team-title h3,
  .reason-card h3,
  .steps h3 {
    font-size: 19px;
    margin: 0 0 6px;
    font-weight: 700;
  }
  .activity-copy p,
  .reason-card p,
  .steps p {
    margin: 0;
    color: #4b5563;
    font-size: 13px;
    line-height: 1.85;
  }
  .activity-art {
    height: 116px;
  }
  .blog-section {
    padding-top: 86px;
    padding-bottom: 94px;
  }
  .text-link {
    font-size: 13px;
    font-weight: 700;
    color: #111827;
    text-decoration: none;
    border-bottom: 1px solid #9ca3af;
    padding-bottom: 3px;
  }
  .text-link:hover {
    color: #3b82f6;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }
  .blog-card {
    min-width: 0;
  }
  .blog-image-link {
    display: block;
    aspect-ratio: 1.55;
    border-radius: 10px;
    overflow: hidden;
    background: #eff6ff;
  }
  .blog-image-link img {
