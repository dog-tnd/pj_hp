---
import Layout from '../../layouts/Layout.astro';
import TwoLine from '../../components/TwoLine.astro';
import BlogArticleView from '../../components/BlogArticleView.astro';
import { getAllPosts, getImageUrl, getAuthorImageUrl, type BlogPost } from '../../lib/microcms';
import { formatDotDate } from '../../utils/date';

// 記事データの取得（microCMS から公開済み記事を全件取得、publishedAt 降順）
export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts.map((post, index) => {
    // 前後の記事を取得
    const prevPost = index > 0 ? {
      url: `/blog/${posts[index - 1].id}`,
      title: posts[index - 1].title
    } : undefined;

    const nextPost = index < posts.length - 1 ? {
      url: `/blog/${posts[index + 1].id}`,
      title: posts[index + 1].title
    } : undefined;

    // 関連記事を取得（同じタグを持つ記事、または最新の記事）
    const relatedPosts = posts
      .filter((p, i) => {
        return i !== index && (
          (post.tags && p.tags &&
           post.tags.some((tag) => p.tags!.some((pt) => pt.id === tag.id))) ||
          i < 3
        );
      })
      .slice(0, 3)
      .map(p => ({
        url: `/blog/${p.id}`,
        title: p.title,
        description: p.description,
        image: getImageUrl(p),
        date: formatDotDate(p.publishedAt)
      }));

    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost, relatedPosts },
    };
  });
}

interface Props {
  post: BlogPost;
  nextPost?: { url: string; title: string };
  prevPost?: { url: string; title: string };
  relatedPosts?: Array<{
    url: string;
    title: string;
    description: string;
    image: string;
    date: string;
  }>;
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props as Props;

// 現在のURLを取得（canonical / 構造化データ用）
const canonicalURL = new URL(`/blog/${post.id}`, Astro.site);
---

<Layout
  title={`${post.title} | TND - 東京理科大学プログラミングサークル`}
  description={post.description}
  image={getImageUrl(post)}
  canonicalURL={canonicalURL.href}
  keywords={post.tags ? ["TND", "東京理科大学", "プログラミングサークル", ...post.tags.map((tag) => tag.name)] : ["TND", "東京理科大学", "プログラミングサークル"]}
  author={post.author}
  type="article"
>
  <!-- 追加のブログ記事用構造化データ -->
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: post.title,
      description: post.description,
      image: getImageUrl(post),
      author: {
        "@type": "Person",
        name: post.author,
        image: getAuthorImageUrl(post),
        jobTitle: post.role,
      },
      publisher: {
        "@type": "Organization",
        name: "TND",
        logo: {
          "@type": "ImageObject",
          url: "https://tus-tnd.com/logo.svg",
        },
      },
      datePublished: new Date(post.publishedAt!).toISOString(),
      dateModified: new Date(post.updatedAt).toISOString(),
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL.href,
      },
    })}
  />

  <header>
    <TwoLine />
  </header>

  <BlogArticleView
    post={post}
    prevPost={prevPost}
    nextPost={nextPost}
    relatedPosts={relatedPosts}
  />

  <footer class="mt-24 border-t border-gray-200 py-8">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm text-gray-500">© 2025 TND All Rights Reserved.</p>
    </div>
  </footer>
</Layout>
