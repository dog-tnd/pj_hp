---
import Layout from "../../layouts/Layout.astro";
import FaqView from "../../components/faq/FaqView.astro";
import { getAllFaqEntries } from "../../lib/microcms";
import { toFaqPageJsonLd, toFaqSections } from "../../utils/faq";

// 質問と回答は microCMS の faq から取得する（spec 004）。表示と FAQPage の構造化データは同じデータから作る
const sections = toFaqSections(await getAllFaqEntries());
// 回答に "</script>" が含まれても script タグを閉じないよう < をエスケープする
const faqJsonLd = JSON.stringify(toFaqPageJsonLd(sections)).replace(
  /</g,
  "\\u003c",
);
---

<Layout
  title="よくある質問 | プログラミングサークル TND"
  description="プログラミングサークルTND（東京理科大学）へのよくある質問。初心者でも参加できるか、所属している学科、学べる内容、勉強会の頻度（週1回）、入会の時期（毎年4〜5月）などに答えます。"
>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={faqJsonLd}
  ></script>
  <FaqView sections={sections} />
</Layout>
