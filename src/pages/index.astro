---
import Layout from "../layouts/Layout.astro";
import TwoLine from "../components/TwoLine.astro";
import NewsCard from "../components/NewsCard";
import { getAllPosts, getImageUrl, getAuthorImageUrl } from "../lib/microcms";
import { formatDotDate } from "../utils/date";

// ブログ記事の取得（microCMS から公開済み記事を全件取得、publishedAt 降順）
const sortedPosts = await getAllPosts();

// 最新の記事を取得（最大4件）
const latestPosts = sortedPosts.slice(0, 4);
---

<Layout
  title="TND - 東京理科大学プログラミングサークル | Web開発・データサイエンス"
  description="TNDは東京理科大学野田キャンパスで活動するプログラミングサークルです。Web開発やデータサイエンスに挑戦し、メンバーと共に成長を目指しています。初心者から上級者まで歓迎！"
  keywords={[
    "東京理科大学",
    "プログラミングサークル",
    "TND",
    "Web開発",
    "データサイエンス",
    "野田キャンパス",
    "大学生",
    "プログラミング",
    "React",
    "TypeScript",
  ]}
  canonicalURL="https://tus-tnd.com/"
  image="/mainCharm.svg"
  type="website"
>
  <header>
    <TwoLine />
  </header>

  <!-- Layout が <main> を持つので div。幅と余白は docs/design/README.md に合わせる -->
  <div class="mx-auto max-w-[1440px] px-6 lg:px-20">
    <div class="relative">
      <!-- What's TND（デザインシステム「項目の見出し」。ページの見出しが無いので上の線なし・上の余白はページの見出しと同じ） -->
      <section
        aria-labelledby="whats-tnd"
        class="grid grid-cols-1 gap-3.5 pb-8 pt-[72px] lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-14 lg:pb-[52px] lg:pt-[104px]"
      >
        <div>
          <p
            aria-hidden="true"
            class="font-['Rubik_Doodle_Shadow'] text-2xl leading-tight text-blue-500 lg:text-[28px]"
          >
            WHAT'S TND
          </p>
          <h2
            id="whats-tnd"
            class="mt-2 text-[19px] font-bold lg:mt-2.5 lg:text-2xl"
          >
            TNDとは
          </h2>
        </div>
        <div class="max-w-[640px] space-y-4 text-[15px] leading-[1.9] text-gray-600 lg:text-lg">
          <p>
            TNDはweb開発をメインに活動する東京理科大学のプログラミングサークルです。2024年に設立され、現在は40名のメンバーが所属しています。
          </p>
          <p>
            フロントエンド、バックエンド、デザイン、データサイエンスなど様々な分野の技術を学び、実践しています。
          </p>
        </div>
      </section>
      <!-- メインビジュアル（spec 005 D2 でそのまま）。外枠の py-12 が無くなった分、top を 5rem → 8rem にして上下の位置を保つ -->
      <img
        src="/mainCharm.svg"
        alt="mainCharm"
        class="w-full md:w-auto md:absolute top-[8rem] right-[2rem] max-w-xs md:max-w-md lg:max-w-lg pb-[5rem] opacity-30 -z-10"
      />
    </div>

    <!-- NEWS（デザインシステム「項目の見出し」の上置き。カードの一覧は幅が要るので見出しを上に置く） -->
    <section
      aria-labelledby="news"
      class="grid grid-cols-1 gap-3.5 border-t border-gray-200 pt-8 lg:gap-8 lg:pt-[52px]"
    >
      <div>
        <p
          aria-hidden="true"
          class="font-['Rubik_Doodle_Shadow'] text-2xl leading-tight text-blue-500 lg:text-[28px]"
        >
          NEWS
        </p>
        <h2 id="news" class="mt-2 text-[19px] font-bold lg:mt-2.5 lg:text-2xl">
          新着記事
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 custom-md:grid-cols-3 gap-6 w-full">
        {latestPosts.map((post, index) => {
          const postUrl = `/blog/${post.id}`;

          return (
            <div
              class="animate-fade-in"
              style={`animation-delay: ${0.4 + (index % 6) * 0.1}s`}
            >
              <NewsCard
                image={getImageUrl(post)}
                title={post.title}
                description={post.description}
                author={post.author}
                role={post.role}
                authorImage={getAuthorImageUrl(post)}
                date={formatDotDate(post.publishedAt)}
                url={postUrl}
                client:load
              />
            </div>
          );
        })}
      </div>
      <!-- もっと見るボタン（5件以上で表示）。デザインシステムの枠線のボタン -->
      {sortedPosts.length > 4 && (
        <div class="text-center">
          <a
            href="/blog"
            class="inline-flex h-12 items-center gap-2 rounded-[10px] border border-blue-500 bg-white px-[18px] text-sm font-bold text-blue-700 transition-colors hover:bg-blue-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 lg:h-11"
          >
            もっと見る
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M9 18l6-6-6-6"></path>
            </svg>
          </a>
        </div>
      )}
    </section>
  </div>

  <!-- SNS LOGOs - 固定位置（PC画面のみ） -->
  <div
    class="hidden md:flex fixed bottom-4 left-4 z-[9999] flex-col items-center gap-3 bg-white/20 backdrop-blur-sm rounded-lg p-4 shadow-xl border border-gray-200/50"
    style="position: fixed !important;"
  >
    <p class="text-xs text-gray-700 font-semibold mb-1">Follow</p>
    <a
      href="https://x.com/TokyorikaND"
      target="_blank"
      rel="noopener noreferrer"
      class="block"
    >
      <img
        src="/sns-x.png"
        alt="XIcon"
        class="w-8 h-8 hover:opacity-70 transition-all duration-300 hover:scale-125 block"
        style="display: block !important;"
      />
    </a>
    <a
      href="https://discord.gg/k3qMBEn3CC"
      target="_blank"
      rel="noopener noreferrer"
      class="block"
    >
      <img
        src="/sns-discord.svg"
        alt="DiscordIcon"
        class="w-8 h-8 hover:opacity-70 transition-all duration-300 hover:scale-125 block"
        style="display: block !important;"
      />
    </a>
  </div>

  <!-- Footer -->
  <footer class="mt-24 border-t border-gray-200 py-8">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm text-gray-500">© 2026 TND All Rights Reserved.</p>
    </div>
  </footer>
</Layout>
