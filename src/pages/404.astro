---
import Layout from "../layouts/Layout.astro";
import NotFoundTerminal from "../components/not-found/NotFoundTerminal.astro";

// 見出しはデザインシステムの「ページの見出し」。右の列は 1024px 以上だけのターミナル（spec 007）
const links = [
  { href: "/blog", label: "テックブログ" },
  { href: "/about", label: "私たちについて" },
  { href: "/faq", label: "よくある質問" },
  { href: "/contact", label: "お問い合わせ" },
];
const focusClass =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 focus-visible:outline-solid";
---

<Layout title="ページが見つかりません | プログラミングサークル TND" noindex>
  <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-14 px-6 pt-[72px] lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:px-20 lg:pt-[104px]">
    <div>
      <p class="text-[11px] leading-relaxed font-medium tracking-[0.2em] text-gray-500 lg:text-sm lg:leading-5 lg:tracking-[0.22em]">
        TOKYO UNIVERSITY OF SCIENCE /
        <span class="whitespace-nowrap">NODA CAMPUS</span>
      </p>
      <p
        class="mt-3.5 text-[42px] leading-none text-blue-500 md:text-[64px] lg:mt-5 lg:text-[72px] custom-md:text-[92px]"
        style="font-family: 'Rubik Doodle Shadow';"
        aria-hidden="true"
      >
        404
      </p>
      <h1 class="mt-4 text-[22px] font-bold tracking-[0.04em] text-gray-900 lg:mt-6 lg:text-[30px]">
        ページが見つかりません
      </h1>
      <p class="mt-5 max-w-[560px] text-[15px] leading-[1.9] text-gray-600 lg:text-lg lg:leading-loose">
        お探しのページは、移動したか削除された可能性があります。URLをもう一度確かめるか、下のリンクからお探しください。
      </p>

      <nav aria-label="ほかのページ" class="mt-7">
        <a
          href="/"
          class:list={[
            "inline-flex h-12 items-center gap-2 rounded-[10px] border border-blue-500 bg-white px-[18px] text-sm font-bold text-blue-700 hover:bg-blue-50 lg:h-11",
            focusClass,
          ]}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5M11 6l-6 6 6 6"></path>
          </svg>
          トップへ戻る
        </a>
        <ul class="mt-3 flex flex-wrap gap-x-6">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "inline-flex min-h-11 items-center text-[15px] font-medium text-blue-600 hover:text-blue-700 hover:underline",
                  focusClass,
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <NotFoundTerminal />
  </div>
</Layout>
